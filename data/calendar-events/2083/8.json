  "holiFest": [
    "०१अष्टमीव्रत, गोरखकाली पूजा, भौमाष्टमी०२कुष्माण्ड नवमी०३बलम्वु महालक्ष्मी यात्रा०४हरिबोधिनी एकादशी, तुलसी विवाह०५चाँगुनारायण अखण्डदीप दर्शन०७वैकुण्ठ चतुर्दशी०८गुरूनानक जयन्ती (शिख धर्मावलम्बी कर्मचारीहरुका लागि मात्र बिदा), चतुर्मासव्रत समाप्ति, सकिमना पुन्हिः१५भैरवाष्टमी१७विश्व अपाङ्ग दिवस (अपाङ्गता भएका कर्मचारीहरूका लागि बिदा), श्री गुहेश्वरी यात्रा१८उत्पत्तिका एकादशी२०पशुपतिनाथ मेला२१बाला चतुर्दशी, शतबीज छर्ने, बाला चःह्रे२४विश्व मानव अधिकार दिवस२८विवाह पञ्चमी, जनकपुरमा सीता विवाह पञ्चमी मेला, ब्रम्हचारी षडानन्द जयन्ती"
  ],
  "marriage": [
    "९, १०, १६, १७, १९, २४, २५ र  २६ गते"
  ],
  "bratabandha": [
    "यो महिना को लागी ब्रतबन्ध मुर्हुत छैन ।"
  ]
