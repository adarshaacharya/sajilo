  "holiFest": [
    "०१नाग पञ्चमी (नाग टाँस्ने)०२कल्की जयन्ती०३गोश्वामी तुलसीदास जयन्ती, राष्ट्रिय सूचना दिवस०४अष्टमीव्रत, यल पञ्चदान, गोरखकाली पूजा०७पुत्रदा एकादशी११पूर्णिमाव्रत, बाजुरा बडिमालिका मेला१२ऋषितर्पणी, रक्षाबन्धन, जनैपूर्णिमा, गुँ:पुन्हिः, क्वाति पुन्हि१३गाईजात्रा (सापारू) (काठमाडौं उपत्यकालाई र देशभरका नेवार समुदायका लागि मात्र बिदा)१४रोपाइँ जात्रा, यल मत्या१६मंगल चौथी, ललितपुर नृसिंह यात्रा१९श्रीकृष्णजन्माष्टमी, गौरा पर्व२०मानव वेचविखन विरुद्धको राष्ट्रिय दिवस२२अजा एकादशी, निजामती सेवा दिवस२३स्वयम्भूको छायाँ दर्शन, जेनजी सहिद दिवस२४यें पञ्चदान, जुगःचह्रे: पुजा२६कुशे औँसी, बाबुको मुख हेर्ने दिन२७गुँलाधर्म समाप्ति२८दरखाने दिन२९हरितालिका व्रत, तीज (महिला कर्मचारीहरूको लागि मात्र बिदा), गणेश चतुर्थी व्रत३०मंगल चौथी, ऋषिपञ्चमीव्रत, सप्तऋषि पूजा३१विरूडा पञ्चमी•मोहम्मद जयन्तीका दिन (भदौ १० गते वा सो जयन्ती पर्ने दिन) नेपाली मुस्लिम धर्मावलम्बीहरूको लागि मात्र बिदा"
  ],
  "marriage": [
    "यो महिना को लागी विवाह मुर्हुत छैन ।"
  ],
  "bratabandha": [
