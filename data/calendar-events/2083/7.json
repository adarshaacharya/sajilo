  "holiFest": [
    "०१महाअष्टमी, कालरात्रि, कुछि भ्वय्०२जनबहाः कुछि भ्वय्०३महानवमी, स्याक्वःत्याक्वः०४विजया दशमी, दशैको टिका, देवी  विसर्जन०५पापाङकुशा एकादशी, अन्नपूर्णा  यात्रा, असँः चालें:०६द्वादशी०८कोजाग्रतव्रत, पूर्णिमा व्रत०९कोजाग्रत पूर्णिमा, कतिं पुन्हिः, कात्तिकस्नान, आकाशदीपदान आरम्भ१५रवि सप्तमी१६अष्टमीव्रत, गोरखकाली पूजा, राधा अष्टमी१९रमा एकादशी२०धन्तेरस, यमदीप दान२१काग तिहार, धन्वन्तरी जयन्ती२२कुकुर तिहार, नरक चतुर्दशी, स्वःन्ति चःह्रे, लक्ष्मी पूजा, दीपमालिका२३औंसी, गाई पूजा, लतिपा अँसि, धुकु लक्ष्मी द्यःपूजा२४स्वःन्ति पारू, गोरू पूजा, गोवर्द्धन  पूजा, म्हःपूजा, ने. स. ११४७ प्रारम्भ २५भाइटीका, किजा पूजा, यम द्वितीया, फाल्गुनन्द जयन्ती२६तृतीया२९छठपर्व, डाला पूजा"
  ],
  "marriage": [
    "यो महिना को लागी विवाह मुर्हुत छैन ।"
  ],
  "bratabandha": [
    "यो महिना को लागी ब्रतबन्ध मुर्हुत छैन ।"
  ]
