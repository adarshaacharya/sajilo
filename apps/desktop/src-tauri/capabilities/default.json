{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The minimum the popover needs. Anything not listed here is unreachable from the web layer by design.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:event:default",
    "store:default",
    "notification:default",
    "dialog:default",
    "opener:allow-open-url",
    "positioner:default",
    "autostart:default"
  ]
}
