---
import type { MarkdownHeading } from "astro";
import AppFrame from "../components/AppFrame.astro";
import { type Doc, docHref, orderedDocs, SECTIONS } from "../lib/docs";
import Base from "./Base.astro";

interface Props {
  doc: Doc;
  headings: MarkdownHeading[];
}

const { doc, headings } = Astro.props;
const all = await orderedDocs();
const index = all.findIndex((page) => page.id === doc.id);
const previous = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;
const section = SECTIONS.find((s) => s.id === doc.data.section);
const toc = headings.filter((heading) => heading.depth === 2);
const screen = doc.data.screen;
const frameTitle = `Sajilo open on ${doc.data.nav ?? doc.data.title}`;
const groups = SECTIONS.map((s) => ({
  ...s,
  pages: all.filter((page) => page.data.section === s.id),
}));
---

<Base
  title={`${doc.data.title}: Sajilo docs`}
  description={doc.data.description}
  path={docHref(doc)}
>
  <div class="docs wrap" id="main">
    <!-- Two copies of one list: a disclosure on narrow screens, a column on
         wide ones. Rendering both keeps it working without JavaScript. -->
    <details class="docs-menu">
      <summary>Docs menu</summary>
      <nav aria-label="Docs">
        {groups.map((group) => (
          <div class="docs-group">
            <p class="docs-group-label">{group.label}</p>
            <ul>
              {group.pages.map((page) => (
                <li>
                  <a href={docHref(page)} aria-current={page.id === doc.id ? "page" : undefined}>
                    {page.data.nav ?? page.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </details>

    <aside class="docs-side">
      <nav aria-label="Docs">
        <a class="docs-home" href="/docs.html">Sajilo docs</a>
        {groups.map((group) => (
          <div class="docs-group">
            <p class="docs-group-label">{group.label}</p>
            <ul>
              {group.pages.map((page) => (
                <li>
                  <a href={docHref(page)} aria-current={page.id === doc.id ? "page" : undefined}>
                    {page.data.nav ?? page.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <main class="docs-main">
      <p class="docs-kicker">{section?.label}</p>
      <h1 class="docs-title">{doc.data.title}</h1>
      <p class="docs-lede">{doc.data.description}</p>

      {screen && (
        <div class="docs-frame-inline">
          <AppFrame route={screen} title={frameTitle} />
        </div>
      )}

      {toc.length > 1 && (
        <nav class="docs-toc" aria-label="On this page">
          <p>On this page</p>
          <ul>
            {toc.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <slot />
      </div>

      <nav class="docs-pager" aria-label="Previous and next">
        {previous ? (
          <a class="docs-pager-link" href={docHref(previous)}>
            <span>Previous</span>
            {previous.data.nav ?? previous.data.title}
          </a>
        ) : <span />}
        {next && (
          <a class="docs-pager-link docs-pager-next" href={docHref(next)}>
            <span>Next</span>
            {next.data.nav ?? next.data.title}
          </a>
        )}
      </nav>
      <p class="docs-help">
        Still stuck? <a href="/report.html">Tell us</a>, or write to
        <a href="mailto:contact@sajilo.fyi">contact@sajilo.fyi</a>.
      </p>
    </main>

    {screen && (
      <aside class="docs-aside" aria-label="The app">
        <div class="docs-aside-sticky">
          <AppFrame route={screen} title={frameTitle} />
          <p class="docs-aside-note">The real app, on this screen.</p>
        </div>
      </aside>
    )}
  </div>
</Base>

<style>
  .docs {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 280px;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    padding-top: clamp(28px, 5vw, 56px);
    padding-bottom: 64px;
  }
  .docs:not(:has(.docs-aside)) {
    grid-template-columns: 220px minmax(0, 1fr);
  }

  /* Sidebar ---------------------------------------------------------- */
  .docs-side {
    position: sticky;
    top: 88px;
    max-height: calc(100dvh - 110px);
    overflow-y: auto;
    padding-right: 6px;
  }
  .docs-home {
    display: block;
    margin-bottom: 18px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    color: var(--paper);
  }
  .docs-group + .docs-group {
    margin-top: 20px;
  }
  .docs-group-label {
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-3);
  }
  .docs-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
  }
  .docs-group a {
    display: block;
    padding: 5px 10px;
    border-radius: 7px;
    font-size: 14.5px;
    color: var(--paper-2);
    transition: color 0.15s, background 0.15s;
  }
  .docs-group a:hover {
    color: var(--paper);
    background: var(--ink-3);
  }
  .docs-group a[aria-current="page"] {
    color: var(--ink);
    background: var(--gilt);
    font-weight: 600;
  }

  .docs-menu {
    display: none;
  }

  /* Article ---------------------------------------------------------- */
  .docs-main {
    min-width: 0;
    max-width: 700px;
  }
  .docs-kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gilt);
  }
  .docs-title {
    margin-top: 8px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.08;
    text-wrap: balance;
  }
  .docs-lede {
    margin-top: 14px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--paper-2);
    text-wrap: pretty;
  }
  .docs-frame-inline {
    display: none;
  }

  .docs-toc {
    margin-top: 26px;
    padding: 14px 18px;
    border-radius: 12px;
    background: var(--ink-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .docs-toc p {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-3);
  }
  .docs-toc ul {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .docs-toc a {
    font-size: 14.5px;
    color: var(--paper-2);
  }
  .docs-toc a:hover {
    color: var(--gilt-2);
  }

  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .docs-pager-link {
    display: grid;
    gap: 2px;
    padding: 12px 16px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-weight: 600;
    color: var(--paper);
    transition: background 0.15s;
  }
  .docs-pager-link span {
    font-size: 12px;
    font-weight: 500;
    color: var(--paper-3);
  }
  .docs-pager-link:hover {
    background: var(--ink-3);
  }
  .docs-pager-next {
    text-align: right;
  }
  .docs-help {
    margin-top: 20px;
    font-size: 14.5px;
    color: var(--paper-3);
  }
  .docs-help a {
    color: var(--gilt);
  }

  /* The app beside the page -------------------------------------------- */
  .docs-aside-sticky {
    position: sticky;
    top: 88px;
  }
  .docs-aside-note {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--paper-3);
    text-align: center;
  }

  /* Narrower screens ---------------------------------------------------- */
  @media (max-width: 1180px) {
    .docs,
    .docs:not(:has(.docs-aside)) {
      grid-template-columns: 200px minmax(0, 1fr);
    }
    .docs-aside {
      display: none;
    }
    .docs-frame-inline {
      display: block;
      width: min(100%, 300px);
      margin-top: 24px;
    }
  }
  @media (max-width: 860px) {
    .docs,
    .docs:not(:has(.docs-aside)) {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .docs-side {
      display: none;
    }
    .docs-menu {
      display: block;
      border-radius: 12px;
      background: var(--ink-2);
      box-shadow: inset 0 0 0 1px var(--line);
    }
    .docs-menu summary {
      padding: 12px 16px;
      font-weight: 600;
      cursor: pointer;
    }
    .docs-menu nav {
      padding: 4px 12px 16px;
    }
    .docs-pager {
      grid-template-columns: 1fr;
    }
    .docs-pager-next {
      text-align: left;
    }
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }
  }

  /* Markdown ------------------------------------------------------------- */
  .prose {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--paper-2);
  }
  .prose :global(h2) {
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-family: var(--display);
    font-weight: 700;
    font-size: 27px;
    line-height: 1.2;
    color: var(--paper);
    scroll-margin-top: 88px;
  }
  .prose :global(h3) {
    margin-top: 28px;
    font-size: 18px;
    font-weight: 600;
    color: var(--paper);
    scroll-margin-top: 88px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(table),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-top: 14px;
  }
  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 10px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(li::marker) {
    color: var(--paper-3);
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--paper);
  }
  .prose :global(a) {
    color: var(--gilt);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--gilt) 40%, transparent);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--gilt-2);
  }
  .prose :global(code) {
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.86em;
    color: var(--paper);
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--ink-2) !important;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
    font-size: 14px;
  }
  .prose :global(kbd) {
    padding: 1px 7px;
    border-radius: 6px;
    background: var(--ink-3);
    box-shadow: inset 0 -1px 0 var(--line-2), inset 0 0 0 1px var(--line-2);
    font-family: var(--mono);
    font-size: 0.82em;
    color: var(--paper);
  }
  /* A blockquote is a note: "> **Tip:** ...". */
  .prose :global(blockquote) {
    margin-left: 0;
    padding: 12px 16px;
    border-left: 3px solid var(--gilt);
    border-radius: 0 10px 10px 0;
    background: color-mix(in srgb, var(--gilt) 8%, transparent);
  }
  .prose :global(blockquote p) {
    margin-top: 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-weight: 600;
    color: var(--paper);
  }
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-top: 14px;
    border-radius: 12px;
    box-shadow: 0 0 0 1px var(--line-2);
  }
</style>
