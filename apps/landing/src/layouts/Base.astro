---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogTitle?: string;
}

const { title, description, path = "/", noindex = false, ogTitle = title } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/assets/og-image.png", Astro.site).href;
const ogImageAlt =
  "Sajilo: Nepal, in your menu bar. A Nepali calendar page, NEPSE with an IPO alert, a reminders slip, a newspaper and a radio.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta name="theme-color" content="#14110e" />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Sajilo" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Eczar:wght@600;700;800&family=Anek+Devanagari:wght@400;500;600;700&family=Anek+Latin:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <slot />
    <SiteFooter />

    <script>
      // Reveal-on-scroll. Anything already in view is shown at once; the rest
      // gets `.in` the first time it scrolls into view. An observer does the
      // work, with a throttled scroll check behind it so a section can never
      // stay hidden if the observer is late or unavailable.
      const items = new Set(document.querySelectorAll<HTMLElement>(".reveal"));
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const show = (el: Element) => {
        el.classList.add("in");
        items.delete(el as HTMLElement);
      };

      if (reduce) {
        items.forEach(show);
      } else {
        const sweep = () => {
          const limit = window.innerHeight * 0.96;
          for (const el of Array.from(items)) {
            if (el.getBoundingClientRect().top < limit) show(el);
          }
        };

        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  show(e.target);
                  io.unobserve(e.target);
                }
              }
            },
            { rootMargin: "0px 0px -4% 0px", threshold: 0 },
          );
          items.forEach((el) => io.observe(el));
        }

        let ticking = false;
        const onScroll = () => {
          if (ticking || items.size === 0) return;
          ticking = true;
          requestAnimationFrame(() => {
            sweep();
            ticking = false;
          });
        };
        sweep();
        setTimeout(sweep, 400);
        addEventListener("scroll", onScroll, { passive: true });
        addEventListener("resize", onScroll, { passive: true });
      }
    </script>
  </body>
</html>
