---
import { today, kathmandu, nepse } from "../data/showcase";
import { ne, weekdayNe } from "../lib/format";

const platforms = [
  { id: "macos-arm64", label: "macOS · Apple Silicon", short: "macOS (Apple Silicon)" },
  { id: "macos-x64", label: "macOS · Intel", short: "macOS (Intel)" },
  { id: "windows", label: "Windows", short: "Windows" },
  { id: "linux-deb", label: "Linux · .deb", short: "Linux (.deb)" },
  { id: "linux-rpm", label: "Linux · .rpm", short: "Linux (.rpm)" },
  { id: "linux-appimage", label: "Linux · AppImage", short: "Linux (AppImage)" },
];
const menubarDate = `${ne(today.nepali.day)} ${today.nepaliMonthName} ${ne(today.nepali.year)}`;
---

<section class="hero" id="main">
  <!-- The day's number, patro-sized, as a watermark behind everything. It is
       clipped on its own layer, not by the section, so the platform menu can
       still hang over the ticker below. -->
  <div class="hero-mark-clip" aria-hidden="true">
    <span class="hero-mark" lang="ne">{ne(today.nepali.day)}</span>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-date" lang="ne">{weekdayNe(today.weekday)}, {menubarDate}</p>

      <h1 class="display hero-h1">
        Nepal,<br />
        <span class="hero-h1-line">in your</span><br />
        menu bar.
      </h1>

      <p class="lede">
        Bikram Sambat calendar, festivals, NEPSE, gold, fuel and Kalimati
        prices, weather, exchange rates, rashifal, FM radio and Nepali news,
        in a small menu bar app for macOS, Windows and Linux.
      </p>

      <div class="cta" id="download">
        <a id="primary-download" class="btn btn--accent" href="/dl/macos-arm64" data-label="Download for macOS">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1.5a.75.75 0 0 1 .75.75v6.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V2.25A.75.75 0 0 1 8 1.5ZM2.75 11a.75.75 0 0 1 .75.75v1.5h9v-1.5a.75.75 0 0 1 1.5 0v2.25a.75.75 0 0 1-.75.75h-10.5a.75.75 0 0 1-.75-.75v-2.25a.75.75 0 0 1 .75-.75Z"/></svg>
          <span id="primary-download-label">Download for macOS</span>
        </a>
        <div class="cta-meta">
          <span>Free and open source. No account.</span>
          <details class="platforms">
            <summary>Other platforms</summary>
            <ul>
              {platforms.map((p) => (
                <li><a href={`/dl/${p.id}`} data-platform={p.id}>{p.short}</a></li>
              ))}
            </ul>
          </details>
        </div>
      </div>
      <!-- Unsigned builds: macOS blocks the first open. Said here, where people
           click Download, not only in the Install section at the bottom. -->
      <p class="mac-note" id="mac-note" hidden aria-live="polite">
        <span class="mac-note-before">
          macOS will ask once: open <b>Privacy &amp; Security → Open Anyway</b>.
          <a href="/docs/install-macos.html">How ↗</a>
        </span>
        <span class="mac-note-after" hidden>
          Downloading… Drag Sajilo to Applications, open it, then <b>Open Anyway</b> in Privacy &amp;
          Security. <a href="/docs/install-macos.html">Screenshots ↗</a>
        </span>
      </p>
    </div>

    <div class="hero-stage" aria-hidden="true">
      <div class="menubar">
        <span class="mb-chip" lang="ne">{menubarDate}</span>
        <span class="mb-glyph mb-wifi"></span>
        <span class="mb-glyph mb-batt"></span>
        <span class="mb-clock">Wed 26 Aug&nbsp;&nbsp;14:20</span>
      </div>
      <div class="popover">
        <div class="popover-nib"></div>
        <iframe
          class="popover-app"
          id="hero-app"
          title={`Sajilo open in the menu bar, showing ${today.nepaliMonthName} ${ne(today.nepali.year)}, Kathmandu at ${kathmandu.temperature}°, and NEPSE at ${nepse.value}`}
          tabindex="-1"
          scrolling="no"
          data-src="/assets/app/index.html?route=%2F&inert=1&theme=dark"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Above the ticker that follows, so an open platform menu overlaps it. */
    z-index: 2;
    padding-block: clamp(48px, 8vw, 110px) clamp(40px, 6vw, 80px);
  }
  .hero-mark-clip {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }
  .hero-mark {
    position: absolute;
    right: -0.05em;
    top: -0.12em;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(320px, 52vw, 760px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-2);
    opacity: 0.55;
    pointer-events: none;
    user-select: none;
    animation: mark-drift 18s ease-in-out infinite alternate;
  }
  @keyframes mark-drift {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-2%, 3%, 0); }
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  /* Above the stage. Its entrance animations make the menu bar and popover
     their own layers, and on one column they sit right under the platform
     menu, so without this they paint over it. */
  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-date {
    font-family: var(--deva);
    font-size: 16px;
    color: var(--accent);
    margin-bottom: 26px;
    animation: rise 0.9s var(--ease) both;
  }

  .hero-h1 {
    font-size: clamp(60px, 8.4vw, 124px);
    margin-bottom: 26px;
    animation: rise 1s var(--ease) 0.08s both;
  }
  .hero-h1-line {
    color: var(--accent-2);
  }

  .lede {
    animation: rise 1s var(--ease) 0.16s both;
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    margin-top: 36px;
    animation: rise 1s var(--ease) 0.24s both;
  }
  .cta-meta {
    display: grid;
    gap: 4px;
    font-size: 13.5px;
    color: var(--paper-3);
  }
  .platforms {
    position: relative;
  }
  .mac-note {
    max-width: 46ch;
    margin-top: 16px;
    padding-left: 12px;
    border-left: 2px solid var(--line-2);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--paper-3);
    animation: rise 1s var(--ease) 0.32s both;
  }
  .mac-note b {
    font-weight: 600;
    color: var(--paper-2);
  }
  .mac-note a {
    color: var(--gilt-2);
    white-space: nowrap;
  }
  .mac-note.is-after {
    border-left-color: var(--gilt);
    color: var(--paper-2);
  }
  .platforms summary {
    cursor: pointer;
    list-style: none;
    color: var(--paper-2);
    font-weight: 500;
    width: fit-content;
    border-bottom: 1px dotted var(--paper-4);
  }
  .platforms summary::-webkit-details-marker {
    display: none;
  }
  .platforms summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .platforms ul {
    position: absolute;
    left: 0;
    top: calc(100% + 10px);
    z-index: 5;
    min-width: 220px;
    padding: 6px;
    background: var(--ink-3);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.45);
    animation: pop 0.25s var(--spring) both;
  }
  .platforms li a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--paper);
  }
  .platforms li a:hover {
    background: var(--ink-4);
  }
  .platforms li a[hidden] {
    display: none;
  }

  /* ---------- The stage: menu bar + popover ---------- */

  .hero-stage {
    position: relative;
    justify-self: end;
    width: min(100%, 420px);
  }
  .menubar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    height: 30px;
    padding: 0 14px;
    border-radius: 10px 10px 0 0;
    background: var(--ink-3);
    border: 1px solid var(--line-2);
    border-bottom: 0;
    font-size: 12.5px;
    color: var(--paper-2);
    animation: rise 0.8s var(--ease) 0.3s both;
  }
  .mb-chip {
    margin-right: auto;
    padding: 2px 9px;
    border-radius: 6px;
    background: var(--gilt);
    color: var(--ink);
    font-family: var(--deva);
    font-weight: 600;
    font-size: 12.5px;
    animation: chip-pulse 2.4s var(--ease) 1s 2;
  }
  @keyframes chip-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgb(217 169 74 / 0.5); }
    40% { box-shadow: 0 0 0 7px rgb(217 169 74 / 0); }
  }
  .mb-glyph {
    width: 14px;
    height: 10px;
    border-radius: 2px;
    background: var(--paper-3);
    opacity: 0.8;
  }
  .mb-wifi {
    width: 12px;
    height: 12px;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    background: none;
    border: 2px solid var(--paper-3);
    border-bottom: 0;
  }
  .mb-batt {
    position: relative;
    width: 20px;
    height: 10px;
    border: 1.5px solid var(--paper-3);
    background: none;
  }
  .mb-batt::after {
    content: "";
    position: absolute;
    inset: 1.5px;
    right: 5px;
    background: var(--paper-3);
    border-radius: 1px;
  }
  .mb-clock {
    font-variant-numeric: tabular-nums;
  }

  .popover {
    position: relative;
    margin-top: 10px;
    transform-origin: 50% -20px;
    animation: drop 1.1s var(--spring) 0.55s both;
  }
  .popover-nib {
    position: absolute;
    left: 28px;
    top: -7px;
    width: 14px;
    height: 14px;
    transform: rotate(45deg);
    background: #0e0e10;
    border-left: 1px solid var(--line-2);
    border-top: 1px solid var(--line-2);
    border-radius: 3px 0 0 0;
  }
  .popover-app {
    display: block;
    width: 100%;
    aspect-ratio: 380 / 560;
    border: 1px solid var(--line-2);
    border-radius: 18px;
    background: #0e0e10;
    box-shadow:
      0 40px 80px -20px rgb(0 0 0 / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.03) inset;
    pointer-events: none;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes drop {
    from { opacity: 0; transform: translateY(-24px) scaleY(0.92); }
    to { opacity: 1; transform: none; }
  }
  @keyframes pop {
    from { opacity: 0; transform: translateY(-6px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-stage {
      justify-self: center;
      width: min(100%, 380px);
    }
    .hero-mark {
      font-size: clamp(260px, 80vw, 420px);
      right: -0.1em;
      top: 0;
    }
  }
</style>

<script>
  import { detectPlatform, DOWNLOAD_STARTED } from "../scripts/platform";

  // Which download the big button offers; see `detectPlatform`.
  const btn = document.getElementById("primary-download") as HTMLAnchorElement;
  const label = document.getElementById("primary-download-label")!;
  const ua = navigator.userAgent;
  const detected = detectPlatform();
  btn.href = `/dl/${detected.platform}`;
  label.textContent = detected.label;
  document.querySelectorAll<HTMLAnchorElement>(".platforms a").forEach((a) => {
    a.hidden = a.dataset.platform === detected.platform;
  });

  // Mac visitors get the Gatekeeper note under the button, and the next steps
  // once they have actually started a macOS download.
  const macNote = document.getElementById("mac-note");
  if (macNote) {
    const showAfter = () => {
      macNote.hidden = false;
      macNote.querySelector<HTMLElement>(".mac-note-before")!.hidden = true;
      macNote.querySelector<HTMLElement>(".mac-note-after")!.hidden = false;
      macNote.classList.add("is-after");
    };
    if (/Macintosh/.test(ua)) macNote.hidden = false;
    const isMacLink = (a: HTMLAnchorElement) => /\/dl\/macos-/.test(a.getAttribute("href") ?? "");
    [btn, ...document.querySelectorAll<HTMLAnchorElement>(".platforms a")].forEach((a) =>
      a.addEventListener("click", () => {
        if (isMacLink(a)) showAfter();
      }),
    );
    // The nav's Download button starts the same file from further down the
    // page; the next steps belong here all the same.
    addEventListener(DOWNLOAD_STARTED, (event) => {
      if ((event as CustomEvent<{ mac: boolean }>).detail.mac) showAfter();
    });
  }

  // A menu, not a disclosure: it closes on a click elsewhere, on Escape, and
  // once a platform is picked.
  const platforms = document.querySelector<HTMLDetailsElement>(".platforms");
  if (platforms) {
    document.addEventListener("click", (event) => {
      if (platforms.open && !platforms.contains(event.target as Node)) platforms.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && platforms.open) {
        platforms.open = false;
        platforms.querySelector("summary")?.focus();
      }
    });
    platforms.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        platforms.open = false;
      }),
    );
  }

  // The app is only mounted once the fonts are in, so its first paint is the
  // right one rather than a fallback-font flash inside the frame.
  const frame = document.getElementById("hero-app") as HTMLIFrameElement;
  const mount = () => { if (!frame.src) frame.src = frame.dataset.src!; };
  if (document.fonts?.ready) document.fonts.ready.then(mount, mount);
  else mount();
  setTimeout(mount, 1500);
</script>
