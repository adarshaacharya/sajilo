---
const links = [
  { href: "/#tour", label: "Screens" },
  { href: "/releases.html", label: "Releases" },
  { href: "/#install", label: "Install" },
  { href: "/docs.html", label: "Docs" },
  { href: "/support.html", label: "Support" },
  { href: "/report.html", label: "Report issue" },
];
---

<header class="nav-shell" id="top">
  <nav class="wrap nav" aria-label="Primary">
    <a class="brand" href="/">
      <span class="brand-deva" lang="ne">सजिलो</span>
    </a>
    <ul class="nav-links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <div class="nav-actions">
      <a class="nav-gh" href="https://github.com/adarshaacharya/sajilo" target="_blank" rel="noopener" aria-label="Source on GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <a class="btn btn--sm" href="/#download" data-download>Download</a>
      <button
        class="nav-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </nav>

  <!-- Phones only: the same links, which the row above hides below 800px. -->
  <div class="nav-menu" id="nav-menu" hidden>
    <ul class="wrap">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</header>

<style>
  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .nav-shell.scrolled,
  .nav-shell.open {
    border-bottom-color: var(--line);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    margin-right: auto;
  }
  .brand-deva {
    font-family: var(--display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1;
    color: var(--paper);
  }
  .nav-links {
    display: flex;
    gap: 4px;
  }
  .nav-links a {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--paper-2);
    transition: color 0.2s, background 0.2s;
  }
  .nav-links a:hover {
    color: var(--paper);
    background: var(--ink-3);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav-gh {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition: color 0.2s, background 0.2s;
  }
  .nav-gh:hover {
    color: var(--paper);
    background: var(--ink-3);
  }
  .nav-gh svg {
    width: 17px;
    height: 17px;
  }

  /* Two bars that fold into an X. Hidden until the link row is. */
  .nav-toggle {
    display: none;
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition: background 0.2s;
  }
  .nav-toggle:hover {
    background: var(--ink-3);
  }
  .bar {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--paper);
    transition: transform 0.3s var(--ease);
  }
  .bar:first-child {
    transform: translateY(-3.5px);
  }
  .bar:last-child {
    transform: translateY(3.5px);
  }
  .nav-toggle[aria-expanded="true"] .bar:first-child {
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .bar:last-child {
    transform: rotate(-45deg);
  }

  .nav-menu ul {
    display: grid;
    gap: 2px;
    padding-block: 8px 16px;
  }
  .nav-menu a {
    display: block;
    padding: 12px 4px;
    font-size: 17px;
    font-weight: 500;
    color: var(--paper-2);
    border-bottom: 1px solid var(--line);
    transition: color 0.2s;
  }
  .nav-menu li:last-child a {
    border-bottom: 0;
  }
  .nav-menu a:hover {
    color: var(--paper);
  }

  @media (max-width: 800px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
    .nav-shell.open {
      background: var(--ink);
    }
  }
  /* A menu opened on a phone must not linger once the window is wide enough
     for the real link row. */
  @media (min-width: 801px) {
    .nav-menu {
      display: none;
    }
  }
</style>

<script>
  import { detectPlatform, DOWNLOAD_STARTED } from "../scripts/platform";

  // Download means download: the button starts this visitor's file at once
  // instead of only scrolling to the hero's button. On the home page it also
  // brings that button and its next steps into view; elsewhere the file just
  // downloads and the page stays put. Without JavaScript it is still a link
  // to the download section.
  // The same goes for the footer's Download and for a docs link written as
  // `/dl/auto` ("the latest Sajilo for this computer"), which has no way to
  // know the visitor's system on its own.
  const detected = detectPlatform();
  document
    .querySelectorAll<HTMLAnchorElement>('[data-download], a[href="/dl/auto"]')
    .forEach((download) => {
      download.href = `/dl/${detected.platform}`;
      download.addEventListener("click", () => {
        const hero = document.getElementById("download");
        if (!hero) return;
        hero.scrollIntoView({ behavior: "smooth", block: "center" });
        dispatchEvent(new CustomEvent(DOWNLOAD_STARTED, { detail: { mac: detected.mac } }));
      });
    });

  const shell = document.querySelector<HTMLElement>(".nav-shell");
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const menu = document.querySelector<HTMLElement>("#nav-menu");

  const sync = () => shell?.classList.toggle("scrolled", window.scrollY > 8);
  sync();
  addEventListener("scroll", sync, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu || !shell) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Menu");
    menu.hidden = !open;
    shell.classList.toggle("open", open);
  };

  toggle?.addEventListener("click", () => setOpen(menu?.hidden ?? false));
  // Following a link — including a same-page #anchor — should close it.
  menu?.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setOpen(false);
  });
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });
  addEventListener("click", (e) => {
    if (menu && !menu.hidden && !shell?.contains(e.target as Node)) setOpen(false);
  });
  matchMedia("(min-width: 801px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
