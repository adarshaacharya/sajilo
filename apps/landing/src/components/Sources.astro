---
import { newsSources } from "../data/showcase";

const newsrooms = newsSources.map((s) => s.name);
---

<section class="newsrooms wrap reveal" id="newsrooms" aria-labelledby="newsrooms-title">
  <p class="eyebrow" id="newsrooms-title">Newsrooms</p>
  <p class="newsroom-list">
    {newsrooms.map((n, i) => (
      <>
        <span>{n}</span>{i < newsrooms.length - 1 && <span class="sep" aria-hidden="true">·</span>}
      </>
    ))}
  </p>
</section>

<style>
  .newsrooms {
    position: relative;
    z-index: 1;
    padding-top: clamp(64px, 9vw, 120px);
  }
  .newsroom-list {
    margin-top: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    color: var(--paper);
    text-wrap: pretty;
  }
  .sep {
    color: var(--gilt);
    margin: 0 0.4em;
  }
</style>
