---
// The recorded session, drawn. Every number and every point on the line is
// the recording's (src/data/showcase.ts); the chart is the same minute-by-
// minute series the app plots, laid out here as one wide stroke.
import { ipo, mutualFunds, nepse, nepseIntraday } from "../data/showcase";
import { rs, signed, nepalClock, ne } from "../lib/format";

const W = 800;
const H = 260;
const PAD = { top: 18, bottom: 26, left: 0, right: 0 };

const values = nepseIntraday.map((p) => p.value);
const previousClose = nepse.value - nepse.change;
const lo = Math.min(...values, previousClose);
const hi = Math.max(...values, previousClose);
const span = hi - lo || 1;
const x = (i: number) => PAD.left + (i / (values.length - 1)) * (W - PAD.left - PAD.right);
const y = (v: number) => PAD.top + (1 - (v - lo) / span) * (H - PAD.top - PAD.bottom);

const line = values.map((v, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(" ");
const area = `${line} L${x(values.length - 1).toFixed(1)} ${H} L${x(0).toFixed(1)} ${H} Z`;
const closeY = y(previousClose).toFixed(1);
const lastX = x(values.length - 1).toFixed(1);
const lastY = y(values[values.length - 1]).toFixed(1);
const up = nepse.change >= 0;

const opened = nepseIntraday[0].time;
const closed = nepseIntraday[nepseIntraday.length - 1].time;
const high = Math.max(...values);
const low = Math.min(...values);

const { advanced, declined, unchanged } = nepse.breadth;
const total = advanced + declined + unchanged;
const crore = (n: number) => `${(n / 1e7).toFixed(1)} crore`;
const times = ipo && ipo.units > 0 ? Math.round(ipo.applied / ipo.units) : 0;
// Three live screens rather than pictures of them: the open-ended list, the
// closed-ended one, and one fund (the largest open-ended one recorded).
const FUNDS = "/bazar?tab=stocks&view=funds";
const fundScreens = [
  {
    title: "Open-ended",
    route: FUNDS,
    caption: `All ${mutualFunds.openEnd}, the ones an SIP buys, ranked by the week's move. Star the ones you hold and they stay at the top.`,
  },
  {
    title: "Closed-ended",
    route: `${FUNDS}&kind=closedEnd`,
    caption: `All ${mutualFunds.closedEnd}, ranked by how far below NAV NEPSE is selling them, plus the ${mutualFunds.matured} that have matured.`,
  },
  {
    title: "One fund",
    route: `${FUNDS}&fund=${encodeURIComponent(mutualFunds.largest[0]?.symbol ?? "")}`,
    caption: "Daily, weekly and monthly NAV, fund size and what it holds. Type in your units to see what they are worth, and set the day your SIP leaves the bank.",
  },
];

const navAsOf = new Date(`${mutualFunds.largest[0]?.navDate}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  timeZone: "UTC",
});
---

<section class="stocks wrap" id="stocks" aria-labelledby="stocks-title">
  <div class="section-head reveal">
    <p class="stocks-mark">
      <span lang="ne">नेप्से</span>
      <span class="stocks-mark-en">Stocks</span>
    </p>
    <h2 id="stocks-title">Check NEPSE <em>without your boss seeing the tab.</em></h2>
    <p class="lede">
      Live NEPSE while the market is open. Gainers, losers and your watchlist, one click away.
    </p>
  </div>

  <div class:list={["board", "reveal", { "is-down": !up }]}>
    <div class="board-head">
      <p class="board-name">NEPSE</p>
      <p class="board-value num">{rs(nepse.value)}</p>
      <p class:list={["board-change", "num", up ? "is-up" : "is-down"]}>
        {signed(nepse.change, 2)} · {signed(nepse.changePercent, 2)}%
      </p>
      <p class="board-when num">Closed {nepalClock(nepse.closedAt)}</p>
    </div>

    <svg class="chart" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`NEPSE through the session, from ${rs(values[0])} to ${rs(values[values.length - 1])}`}>
      <defs>
        <linearGradient id="stocks-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="currentColor" stop-opacity="0.22" />
          <stop offset="1" stop-color="currentColor" stop-opacity="0" />
        </linearGradient>
      </defs>
      <line class="chart-close" x1="0" x2={W} y1={closeY} y2={closeY} />
      <path class="chart-area" d={area} fill="url(#stocks-fill)" />
      <path class="chart-line" d={line} pathLength="1" />
      <circle class="chart-dot" cx={lastX} cy={lastY} r="4" />
    </svg>

    <div class="chart-axis num">
      <span>{nepalClock(opened)}</span>
      <span class="axis-close">prev. close {rs(previousClose)}</span>
      <span>{nepalClock(closed)}</span>
    </div>

    <dl class="board-facts">
      <div><dt>High</dt><dd class="num">{rs(high)}</dd></div>
      <div><dt>Low</dt><dd class="num">{rs(low)}</dd></div>
      <div><dt>Turnover</dt><dd class="num">Rs {crore(nepse.turnover)}</dd></div>
      <div><dt>Listed</dt><dd class="num">{nepse.listed}</dd></div>
    </dl>
  </div>

  <div class="under reveal">
    <div class="breadth">
      <p class="eyebrow">{ne(total)} traded</p>
      <div class="breadth-bar" role="img" aria-label={`${advanced} up, ${unchanged} flat, ${declined} down`}>
        <span class="up" style={`flex:${advanced}`}></span>
        <span class="flat" style={`flex:${unchanged}`}></span>
        <span class="down" style={`flex:${declined}`}></span>
      </div>
      <p class="breadth-legend num">
        <span class="t-up">{advanced} up</span>
        <span>{unchanged} flat</span>
        <span class="t-down">{declined} down</span>
      </p>
    </div>

    <div class="movers">
      <ol class="mover-list" aria-label="Top gainers">
        {nepse.gainers.map((m) => (
          <li><span class="sym">{m.symbol}</span><span class="num t-up">{signed(m.metric, 2)}%</span></li>
        ))}
      </ol>
      <ol class="mover-list" aria-label="Top losers">
        {nepse.losers.map((m) => (
          <li><span class="sym">{m.symbol}</span><span class="num t-down">{signed(m.metric, 2)}%</span></li>
        ))}
      </ol>
    </div>

    <figure class="stocks-stage">
      <div class="stocks-frame">
        <div class="stocks-screen">
          <iframe
            class="stocks-app"
            title="Sajilo stocks screen"
            tabindex="-1"
            scrolling="no"
            loading="lazy"
            src="/assets/app/index.html?route=%2Fbazar%3Ftab%3Dstocks&inert=1&theme=dark"
          ></iframe>
        </div>
      </div>
    </figure>
  </div>

  {ipo && (
    <div class="ipo reveal">
      <div class="ticket">
        <div class="ticket-stub">
          <span class="ticket-kind">IPO</span>
          <span class="ticket-symbol">{ipo.symbol}</span>
        </div>
        <div class="ticket-body">
          <p class="ticket-name">{ipo.name}</p>
          <dl class="ticket-odds">
            <div><dt>Units on offer</dt><dd class="num">{rs(ipo.units)}</dd></div>
            <div><dt>People who applied</dt><dd class="num">{rs(ipo.applications)}</dd></div>
            {times > 1 && <div><dt>Oversubscribed</dt><dd class="num t-up">{times}×</dd></div>}
          </dl>
        </div>
      </div>
      <div class="ipo-copy">
        <h3>Applied from all five family demat accounts. <em>Still not allotted.</em></h3>
        <p>
          Every open IPO shows up in Bazar, with a reminder on the last day. Now you'll only miss the
          allotment, not the deadline.
        </p>
      </div>
    </div>
  )}

  {mutualFunds.largest.length > 0 && (
    <div class="funds reveal">
      <div class="funds-copy">
        <h3>Mutual funds. <em>Let a fund manager lose your money professionally.</em></h3>
        <p>
          The NAV of every fund: {mutualFunds.openEnd} open-ended, {mutualFunds.closedEnd} closed-ended
          and {mutualFunds.matured} matured. Add your units to see what they are worth, which is either
          reassuring or character-building. Set the day your SIP leaves your account and Sajilo tells
          you before the bank does: a few days early, and again on the day.
        </p>
      </div>
      <div class="nav-board">
        <p class="nav-head">
          <span>Largest open-ended funds</span>
          <span class="num">NAV, {navAsOf}</span>
        </p>
        <ol>
          {mutualFunds.largest.map((fund) => (
            <li>
              <span class="sym">{fund.symbol}</span>
              <span class="nav-name">{fund.name}</span>
              <span class="num nav-value">Rs {fund.nav.toFixed(2)}</span>
              <span class:list={["num", "nav-change", fund.change >= 0 ? "t-up" : "t-down"]}>
                {signed(fund.change, 2)}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  )}

  {mutualFunds.largest.length > 0 && (
    <ul class="fund-screens reveal" aria-label="The mutual funds screens">
      {fundScreens.map((screen) => (
        <li class="fund-screen">
          <div class="fund-frame">
            <div class="fund-canvas">
              <iframe
                class="fund-app"
                title={screen.title}
                tabindex="-1"
                scrolling="no"
                loading="lazy"
                src={`/assets/app/index.html?route=${encodeURIComponent(screen.route)}&inert=1&theme=dark`}
              ></iframe>
            </div>
          </div>
          <p class="fund-caption">
            <span class="fund-caption-title">{screen.title}</span>
            {screen.caption}
          </p>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .stocks {
    position: relative;
    z-index: 1;
    padding-top: clamp(80px, 11vw, 160px);
  }
  .stocks-mark {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .stocks-mark [lang="ne"] {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    color: var(--gilt-2);
  }
  .stocks-mark-en {
    font-size: 15px;
    font-weight: 500;
    color: var(--paper-3);
  }

  /* The board: the index set like the patro's date, the line drawn edge to
     edge beneath it. Green is the app's own colour for a rise; sindoor for
     a fall, as on the calendar. */
  .board {
    margin-top: clamp(28px, 4vw, 48px);
    color: var(--leaf);
  }
  .board.is-down {
    color: var(--sindoor-2);
  }
  .board-head {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "name value" "when change";
    column-gap: 20px;
    align-items: baseline;
    color: var(--paper);
  }
  .board-name {
    grid-area: name;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    color: var(--paper-3);
  }
  .board-value {
    grid-area: value;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(56px, 9vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .board-change {
    grid-area: change;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 500;
    margin-top: 6px;
  }
  .board-change.is-up {
    color: var(--leaf);
  }
  .board-change.is-down {
    color: var(--sindoor-2);
  }
  .board-when {
    grid-area: when;
    font-size: 13px;
    color: var(--paper-3);
    margin-top: 6px;
  }

  .chart {
    display: block;
    width: 100%;
    height: clamp(160px, 22vw, 260px);
    margin-top: 12px;
    overflow: visible;
  }
  .chart-close {
    stroke: var(--paper-4);
    stroke-width: 1;
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
  }
  .chart-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .reveal.in .chart-line,
  .reveal.is-in .chart-line {
    animation: draw 1.6s var(--ease) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .chart-dot {
    fill: currentColor;
    stroke: var(--ink);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .chart-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--paper-3);
  }
  .board-facts {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 8px clamp(28px, 5vw, 64px);
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .board-facts dt {
    font-size: 12px;
    color: var(--paper-3);
  }
  .board-facts dd {
    font-size: 17px;
    color: var(--paper);
    margin-top: 2px;
  }

  .under {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 300px);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
    margin-top: clamp(40px, 6vw, 72px);
  }
  .breadth-bar {
    display: flex;
    height: 10px;
    gap: 2px;
    margin-top: 12px;
  }
  .breadth-bar span {
    display: block;
    min-width: 2px;
    border-radius: 2px;
  }
  .breadth-bar .up {
    background: var(--leaf);
  }
  .breadth-bar .flat {
    background: var(--paper-4);
  }
  .breadth-bar .down {
    background: var(--sindoor);
  }
  .breadth-legend {
    display: flex;
    gap: 16px;
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--paper-3);
  }
  .t-up {
    color: var(--leaf);
  }
  .t-down {
    color: var(--sindoor-2);
  }
  .movers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .mover-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
  }
  .mover-list li:first-child {
    border-top: 1px solid var(--line-2);
  }
  .sym {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .stocks-frame {
    position: relative;
    aspect-ratio: 380 / 560;
    border-radius: 18px;
    overflow: hidden;
    background: #1c1c1e;
    border: 1px solid var(--line-2);
    box-shadow: 0 40px 80px -24px rgb(0 0 0 / 0.7);
  }
  .stocks-screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 380px;
    height: 560px;
    transform: scale(var(--fit, 1));
    transform-origin: 0 0;
  }
  .stocks-app {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #1c1c1e;
    pointer-events: none;
  }

  /* The IPO as a lottery ticket: a torn stub, a perforated edge, and the
     odds printed on the face. */
  .ipo {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: clamp(40px, 6vw, 72px);
  }
  .ticket {
    display: flex;
    color: #1f1a14;
    background: #f1e6c8;
    border-radius: 8px;
    transform: rotate(-1.2deg);
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.85);
  }
  .ticket-stub {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 4px;
    padding: 18px 20px;
    color: #f1e6c8;
    background: #a8281a;
    border-radius: 8px 0 0 8px;
    border-right: 3px dashed #f1e6c8;
  }
  .ticket-kind {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }
  .ticket-symbol {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
  }
  .ticket-body {
    flex: 1;
    min-width: 0;
    padding: 16px 20px 18px;
  }
  .ticket-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.2;
  }
  .ticket-odds {
    display: grid;
    gap: 6px;
    margin: 12px 0 0;
  }
  .ticket-odds > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 5px;
    border-bottom: 1px dotted rgb(31 26 20 / 0.3);
  }
  .ticket-odds dt {
    font-size: 13px;
    color: rgb(31 26 20 / 0.6);
  }
  .ticket-odds dd {
    margin: 0;
    font-weight: 700;
    font-size: 15px;
  }
  .ticket-odds .t-up {
    color: #2f7a3e;
  }
  .ipo-copy h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.12;
    color: var(--paper);
  }
  .ipo-copy h3 em {
    font-style: normal;
    color: var(--gilt-2);
  }
  .ipo-copy p {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--paper-2);
  }

  /* Mutual funds: a plain NAV board beside the copy, mirroring the IPO row. */
  .funds {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: clamp(40px, 6vw, 72px);
  }
  .funds-copy h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.12;
    color: var(--paper);
  }
  .funds-copy h3 em {
    font-style: normal;
    color: var(--gilt-2);
  }
  .funds-copy p {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--paper-2);
  }
  .nav-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 8px;
    font-size: 12.5px;
    color: var(--paper-3);
    border-bottom: 1px solid var(--line-2);
  }
  .nav-board li {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) auto 52px;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
  }
  .nav-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13.5px;
    color: var(--paper-3);
  }
  .nav-value {
    color: var(--paper);
  }
  .nav-change {
    text-align: right;
    font-size: 13.5px;
  }

  /* The funds screens: the app at its real popover size, three abreast. */
  .fund-screens {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 32px);
    margin-top: clamp(32px, 5vw, 56px);
    padding: 0;
    list-style: none;
  }
  .fund-frame {
    position: relative;
    aspect-ratio: 380 / 560;
    border-radius: 16px;
    overflow: hidden;
    background: #1c1c1e;
    border: 1px solid var(--line-2);
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.7);
  }
  .fund-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 380px;
    height: 560px;
    transform: scale(var(--fit, 1));
    transform-origin: 0 0;
  }
  .fund-app {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #1c1c1e;
    pointer-events: none;
  }
  .fund-caption {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--paper-3);
    text-wrap: pretty;
  }
  .fund-caption-title {
    display: block;
    margin-bottom: 2px;
    font-weight: 600;
    color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-line {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }
  }
  @media (max-width: 860px) {
    /* One screen at a time, swiped sideways, rather than three unreadable ones. */
    .fund-screens {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: min(78%, 280px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 8px;
    }
    .fund-screen {
      scroll-snap-align: start;
    }
    .ipo,
    .funds {
      grid-template-columns: 1fr;
    }
    .nav-name {
      display: none;
    }
    .nav-board li {
      grid-template-columns: 76px 1fr 52px;
    }
    .board-head {
      grid-template-columns: 1fr;
      grid-template-areas: "name" "value" "change" "when";
    }
    .board-facts {
      grid-template-columns: repeat(2, auto);
    }
    .under {
      grid-template-columns: 1fr;
    }
    .stocks-stage {
      width: min(100%, 300px);
    }
  }
</style>

<script>
  const frame = document.querySelector<HTMLElement>(".stocks-frame");
  const screen = document.querySelector<HTMLElement>(".stocks-screen");
  if (frame && screen) {
    const fit = () => screen.style.setProperty("--fit", String(frame.clientWidth / 380));
    fit();
    new ResizeObserver(fit).observe(frame);
  }

  // Each funds screen scales its 380px app to whatever width its frame has.
  for (const fundFrame of document.querySelectorAll<HTMLElement>(".fund-frame")) {
    const canvas = fundFrame.querySelector<HTMLElement>(".fund-canvas");
    if (!canvas) continue;
    const fitFund = () => canvas.style.setProperty("--fit", String(fundFrame.clientWidth / 380));
    fitFund();
    new ResizeObserver(fitFund).observe(fundFrame);
  }
</script>
