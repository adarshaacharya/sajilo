---
// Keeper is the one screen with nothing recorded in it, on purpose: it holds
// citizenship and passport numbers, so the showcase ships its empty state
// (see apps/showcase-data). What this section shows is the drawer itself —
// the papers and bills Keeper takes, as slips — read off
// apps/desktop/src/features/keeper/_lib. No document, name or date is shown
// as if it were someone's.

interface Slip {
  ne: string;
  en: string;
  /** Bills are smaller, receipt-cut slips; papers are full cards. */
  bill?: boolean;
}

const slips: Slip[] = [
  { ne: "नागरिकता", en: "Citizenship" },
  { ne: "राहदानी", en: "Passport" },
  { ne: "लाइसेन्स", en: "Driving licence" },
  { ne: "ब्लुबुक", en: "Bluebook" },
  { ne: "बीमा", en: "Insurance" },
  { ne: "परिचयपत्र", en: "National ID" },
  { ne: "PAN", en: "PAN" },
  { ne: "वारेन्टी", en: "Warranty" },
  { ne: "बिजुली", en: "Electricity", bill: true },
  { ne: "पानी", en: "Water", bill: true },
  { ne: "इन्टरनेट", en: "Internet", bill: true },
  { ne: "फोन", en: "Telephone", bill: true },
  { ne: "भाडा", en: "Rent", bill: true },
  { ne: "EMI", en: "Loan EMI", bill: true },
  { ne: "सदस्यता", en: "Subscription", bill: true },
  { ne: "अरू", en: "Anything else" },
];
---

<section class="keeper wrap" id="keeper" aria-labelledby="keeper-title">
  <div class="keeper-grid">
    <div class="keeper-main">
      <div class="section-head reveal">
        <p class="keeper-mark">
          <span lang="ne">सम्हाल</span>
          <span class="keeper-mark-en">Keeper</span>
        </p>
        <h2 id="keeper-title">One drawer for everything that lapses.</h2>
        <p class="lede">
          Say whose it is and when it runs out. Keeper nudges you at nine in the morning, Nepal time.
          It lives on your computer — no account, nothing uploaded.
        </p>
      </div>

      <ul class="drawer reveal" aria-label="What Keeper holds">
        {slips.map((s, i) => (
          <li class:list={["slip", { "slip--bill": s.bill }]} style={`--tilt:${(((i * 37) % 11) - 5) * 0.55}deg`}>
            <span class="slip-ne" lang={s.ne === "PAN" || s.ne === "EMI" ? undefined : "ne"}>{s.ne}</span>
            <span class="slip-en">{s.en}</span>
          </li>
        ))}
      </ul>

      <p class="keeper-foot reveal">
        Papers for you and the family. Bills every month. Bluebook tax every Ashad, policies every year.
        A missed one gets one more nudge the morning after.
      </p>
    </div>

    <figure class="keeper-stage reveal">
      <div class="keeper-frame">
        <div class="keeper-screen">
          <iframe
            class="keeper-app"
            title="Sajilo Keeper screen"
            tabindex="-1"
            scrolling="no"
            loading="lazy"
            src="/assets/app/index.html?route=%2Fkeeper&inert=1&theme=dark"
          ></iframe>
        </div>
      </div>
      <figcaption class="keeper-caption">The drawer as it ships, empty.</figcaption>
    </figure>
  </div>
</section>

<style>
  .keeper {
    position: relative;
    z-index: 1;
    padding-top: clamp(80px, 11vw, 160px);
  }
  .keeper-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .keeper-mark {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .keeper-mark [lang="ne"] {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    color: var(--gilt-2);
  }
  .keeper-mark-en {
    font-size: 15px;
    font-weight: 500;
    color: var(--paper-3);
  }

  /* The drawer: paper slips tipped out on the ink, each at its own small
     angle. Cream paper is the one place on the page the ground flips — these
     are the papers, the page is the desk. */
  .drawer {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 12px;
    margin-top: clamp(28px, 4vw, 44px);
    padding: 6px 0 10px;
  }
  .slip {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 14px 16px 12px;
    min-width: 128px;
    background: var(--paper);
    color: var(--ink);
    border-radius: 3px;
    transform: rotate(var(--tilt));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.35) inset,
      0 10px 24px -14px rgb(0 0 0 / 0.9);
    transition: transform 0.45s var(--spring), box-shadow 0.3s;
  }
  /* A stamp-red band along the top edge, like the header stripe of a form. */
  .slip::before {
    content: "";
    position: absolute;
    top: 0;
    left: 12px;
    right: 12px;
    height: 3px;
    border-radius: 0 0 2px 2px;
    background: var(--sindoor);
  }
  .slip:hover {
    transform: rotate(0deg) translateY(-3px);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.35) inset,
      0 18px 30px -14px rgb(0 0 0 / 0.9);
  }
  .slip-ne {
    font-family: var(--display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.05;
  }
  .slip-en {
    font-size: 12px;
    color: var(--paper-4);
    letter-spacing: 0.01em;
  }
  /* Bills are narrower, cut like a till receipt, and take the gilt band. */
  .slip--bill {
    min-width: 104px;
    padding: 12px 14px 10px;
    background: #eadfc8;
    clip-path: polygon(
      0 0, 100% 0, 100% calc(100% - 5px), 92% 100%, 84% calc(100% - 5px), 76% 100%,
      68% calc(100% - 5px), 60% 100%, 52% calc(100% - 5px), 44% 100%, 36% calc(100% - 5px),
      28% 100%, 20% calc(100% - 5px), 12% 100%, 4% calc(100% - 5px), 0 100%
    );
    box-shadow: none;
  }
  .slip--bill::before {
    background: var(--gilt);
  }
  .slip--bill .slip-ne {
    font-size: 20px;
  }
  .slip--bill:hover {
    box-shadow: none;
  }

  .keeper-foot {
    margin-top: clamp(22px, 3vw, 32px);
    max-width: 58ch;
    font-size: 15.5px;
    color: var(--paper-2);
    text-wrap: pretty;
  }

  .keeper-stage {
    position: sticky;
    top: 92px;
  }
  /* Same frame as the tour: the app at its real popover size, scaled down. */
  .keeper-frame {
    position: relative;
    aspect-ratio: 380 / 560;
    border-radius: 18px;
    overflow: hidden;
    background: #1c1c1e;
    border: 1px solid var(--line-2);
    box-shadow: 0 40px 80px -24px rgb(0 0 0 / 0.7);
  }
  .keeper-screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 380px;
    height: 560px;
    transform: scale(var(--fit, 1));
    transform-origin: 0 0;
  }
  .keeper-app {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #1c1c1e;
    pointer-events: none;
  }
  .keeper-caption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--paper-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .slip,
    .slip:hover {
      transition: none;
      transform: none;
    }
  }
  @media (max-width: 860px) {
    .keeper-grid {
      grid-template-columns: 1fr;
    }
    .keeper-stage {
      position: static;
      width: min(100%, 300px);
    }
    .slip {
      min-width: 112px;
      padding: 12px 14px 10px;
    }
    .slip-ne {
      font-size: 21px;
    }
    .slip--bill {
      min-width: 92px;
    }
  }
</style>

<script>
  // Scale the 380px screen to whatever width the frame has.
  const frame = document.querySelector<HTMLElement>(".keeper-frame");
  const screen = document.querySelector<HTMLElement>(".keeper-screen");
  if (frame && screen) {
    const fit = () => screen.style.setProperty("--fit", String(frame.clientWidth / 380));
    fit();
    new ResizeObserver(fit).observe(frame);
  }
</script>
