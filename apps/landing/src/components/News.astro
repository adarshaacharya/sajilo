---
// Every newsroom the app reads, pegged to the string of a Kathmandu news
// stall. Names, which are official and which write in English, and the
// dateline all come from the recording (src/data/showcase.ts). The front pages
// carry no headlines — only grey type-blocks — because the recorded stories
// are left to the live screen: a marketing page is the wrong place to set
// someone's tragedy in display type.
import { newsItems, newsSources, today } from "../data/showcase";
import { ne } from "../lib/format";

const dateline = new Date(`${today.gregorian}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const bsDate = `${ne(today.nepali.day)} ${today.nepaliMonthName} ${ne(today.nepali.year)}`;
// A fixed, gentle disorder — the same on every build, so nothing jumps.
const tilt = (i: number) => [-2.2, 1.4, -0.6, 2.4, -1.6, 0.8, -2.6, 1.8][i % 8];
// Front-page layouts to rotate through: lead photo left, right, or across.
const LAYOUTS = ["lead-left", "lead-top", "lead-right"] as const;
---

<section class="news wrap" id="news" aria-labelledby="news-title">
  <div class="news-grid">
    <div class="news-main">
      <div class="section-head reveal">
        <p class="news-mark">
          <span lang="ne">समाचार</span>
          <span class="news-mark-en">News</span>
        </p>
        <h2 id="news-title">Every front page, <em>before your chiya goes cold.</em></h2>
        <p class="lede">
           Nepali and English newsrooms and
          government notices, merged into one list by time, in your menu bar.
        </p>
      </div>

      <div class="stall reveal" role="list" aria-label="Newsrooms Sajilo reads">
        {newsSources.map((source, i) => (
          <div
            role="listitem"
            class:list={["paper", LAYOUTS[i % 3], { official: source.official }]}
            style={`--tilt:${tilt(i)}deg; --d:${i * 60}ms`}
          >
            <span class="peg" aria-hidden="true"></span>
            <div class="sheet">
              <p class="masthead">{source.name}</p>
              <p class="dateline">
                <span>{source.official ? "सूचना" : source.english ? "English" : "नेपाली"}</span>
                <span class="num">{i % 2 === 0 ? bsDate : dateline}</span>
              </p>
              <div class="page" aria-hidden="true">
                <span class="photo"></span>
                <span class="head"></span>
                <span class="col"></span>
                <span class="col"></span>
              </div>
              {source.official && <span class="seal" aria-hidden="true">सरकारी</span>}
            </div>
          </div>
        ))}
      </div>

      <p class="news-foot reveal">
        <span class="num">{newsSources.length}</span> newsrooms ·
        <span class="num">{newsItems}</span> headlines on the string the morning this page was recorded
      </p>
    </div>

    <div class="news-stage reveal">
      <div class="news-frame">
        <div class="news-screen">
          <iframe
            class="news-app"
            title="Sajilo news screen"
            tabindex="-1"
            loading="lazy"
            src="/assets/app/index.html?route=%2Fnews&inert=1&theme=dark"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .news {
    position: relative;
    z-index: 1;
    padding-top: clamp(80px, 11vw, 160px);
  }
  .news-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .news-mark {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .news-mark [lang="ne"] {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    color: var(--gilt-2);
  }
  .news-mark-en {
    font-size: 15px;
    font-weight: 500;
    color: var(--paper-3);
  }

  /* A Kathmandu news stall: the day's papers pegged along a string, each
     front page a masthead, a dateline, and grey blocks of type. They sway a
     little, the way paper does in a doorway. Government notices get the
     sindoor rule and a rubber stamp. */
  .stall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(138px, 1fr));
    gap: 30px 0;
    margin-top: clamp(32px, 4.4vw, 52px);
  }
  .paper {
    position: relative;
    padding: 16px 7px 0;
  }
  /* Each paper carries its stretch of string, so a wrapped row keeps one. */
  .paper::before {
    content: "";
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    height: 1.5px;
    background: linear-gradient(90deg, #8a7a62, #b9a582, #8a7a62);
    box-shadow: 0 2px 3px rgb(0 0 0 / 0.5);
  }
  .peg {
    position: absolute;
    z-index: 2;
    top: 1px;
    left: 50%;
    width: 9px;
    height: 26px;
    margin-left: -4.5px;
    border-radius: 2px;
    background: linear-gradient(90deg, #a77b4c, #d3a877 45%, #9a6f41);
    box-shadow: 0 3px 4px rgb(0 0 0 / 0.45);
  }
  .sheet {
    position: relative;
    aspect-ratio: 3 / 4;
    padding: 10px 10px 12px;
    color: #1f1a14;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.07), transparent 14%),
      #ece3d0;
    border-radius: 1px;
    transform-origin: 50% 0;
    transform: rotate(var(--tilt));
    box-shadow: 0 18px 26px -14px rgb(0 0 0 / 0.8);
    animation: sway 6s ease-in-out var(--d) infinite alternate;
    transition: transform 0.4s var(--spring);
  }
  .paper:nth-child(3n) .sheet {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.07), transparent 14%),
      #e6dcc4;
  }
  .paper:hover .sheet {
    animation-play-state: paused;
    transform: rotate(0deg) translateY(4px) scale(1.04);
  }
  @keyframes sway {
    from {
      transform: rotate(var(--tilt));
    }
    to {
      transform: rotate(calc(var(--tilt) * -0.6));
    }
  }

  .masthead {
    padding-bottom: 5px;
    border-bottom: 2.5px solid #1f1a14;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(15px, 1.5vw, 19px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
  }
  .official .masthead {
    border-bottom-color: var(--sindoor);
  }
  .dateline {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    padding: 3px 0;
    border-bottom: 1px solid rgb(31 26 20 / 0.35);
    font-size: 8.5px;
    letter-spacing: 0.04em;
    color: rgb(31 26 20 / 0.6);
    white-space: nowrap;
  }
  .dateline .num {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Type as texture: a photo block, a heavy headline bar, and two columns
     of grey lines, arranged a little differently on each paper. */
  .page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto 1fr;
    gap: 6px;
    height: calc(100% - 52px);
    margin-top: 7px;
  }
  .page > span {
    display: block;
    border-radius: 1px;
  }
  .photo {
    background:
      linear-gradient(135deg, rgb(31 26 20 / 0.28), rgb(31 26 20 / 0.12));
    min-height: 38px;
  }
  .head {
    height: 18px;
    background:
      linear-gradient(rgb(31 26 20 / 0.75) 0 6px, transparent 6px 10px, rgb(31 26 20 / 0.5) 10px 15px, transparent 15px);
  }
  .col {
    background: repeating-linear-gradient(180deg, rgb(31 26 20 / 0.2) 0 2px, transparent 2px 5px);
  }
  .lead-left .photo {
    grid-row: 1 / 3;
  }
  .lead-left .head {
    grid-column: 2;
  }
  .lead-top .photo {
    grid-column: 1 / -1;
    min-height: 44px;
  }
  .lead-top .head {
    grid-column: 1 / -1;
  }
  .lead-right .photo {
    grid-column: 2;
    grid-row: 1 / 3;
  }
  .lead-right .head {
    grid-column: 1;
    grid-row: 1;
  }

  .seal {
    position: absolute;
    right: 8px;
    bottom: 14px;
    padding: 2px 7px;
    border: 2px solid rgb(228 71 47 / 0.8);
    border-radius: 3px;
    font-size: 12px;
    font-weight: 700;
    color: rgb(228 71 47 / 0.9);
    background: rgb(236 227 208 / 0.7);
    transform: rotate(-9deg);
  }

  .news-foot {
    margin-top: clamp(20px, 3vw, 28px);
    font-size: 14px;
    color: var(--paper-3);
  }
  .news-foot .num {
    color: var(--gilt-2);
    font-weight: 600;
  }

  .news-stage {
    position: sticky;
    top: 92px;
  }
  .news-frame {
    position: relative;
    aspect-ratio: 380 / 560;
    border-radius: 18px;
    overflow: hidden;
    background: #1c1c1e;
    border: 1px solid var(--line-2);
    box-shadow: 0 40px 80px -24px rgb(0 0 0 / 0.7);
  }
  .news-screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 380px;
    height: 560px;
    transform: scale(var(--fit, 1));
    transform-origin: 0 0;
  }
  .news-app {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #1c1c1e;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      animation: none;
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
    .news-stage {
      position: static;
      width: min(100%, 300px);
    }
  }
</style>

<script>
  const frame = document.querySelector<HTMLElement>(".news-frame");
  const screen = document.querySelector<HTMLElement>(".news-screen");
  if (frame && screen) {
    const fit = () => screen.style.setProperty("--fit", String(frame.clientWidth / 380));
    fit();
    new ResizeObserver(fit).observe(frame);
  }
</script>
