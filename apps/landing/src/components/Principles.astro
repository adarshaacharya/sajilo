---
const items = [
  { ne: "अफलाइन", title: "Offline calendar", copy: "Dates, tithi, festivals and holidays are compiled into the app." },
  { ne: "खाता छैन", title: "No account", copy: "Nothing to sign up for or configure. One anonymous daily count, with an off switch in Settings." },
  { ne: "खुला", title: "Open source", copy: "MIT licensed. Rust and a small web UI. The parsers are all in the repo." },
  { ne: "ताजा", title: "Dated data", copy: "Fetched values keep their fetch time. Old data is marked old; a failed fetch is marked failed." },
];
---

<section class="principles wrap" id="principles">
  <div class="rule reveal"></div>
  <ul class="principle-grid">
    {items.map((p, i) => (
      <li class="principle reveal" style={`--d:${i * 80}ms`}>
        <span class="principle-ne" lang="ne">{p.ne}</span>
        <h3>{p.title}</h3>
        <p>{p.copy}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .principles {
    position: relative;
    z-index: 1;
    padding-top: clamp(64px, 9vw, 120px);
  }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-top: 32px;
  }
  .principle {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .principle-ne {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    color: var(--accent-2);
    margin-bottom: 6px;
  }
  .principle h3 {
    font-size: 17px;
    font-weight: 600;
  }
  .principle p {
    font-size: 14.5px;
    color: var(--paper-3);
    text-wrap: pretty;
  }
  @media (max-width: 860px) {
    .principle-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .principle-grid { grid-template-columns: 1fr; }
  }
</style>
