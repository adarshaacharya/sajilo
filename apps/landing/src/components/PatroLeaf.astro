---
import { today, todayTithi, todayIsHoliday, upcoming, kathmandu, supportedRange, panchang } from "../data/showcase";
import { ne, weekdayNe, longDate, nepalClock, daysAway } from "../lib/format";

const goodWindow = panchang?.chaughadiyaDay.find((c) => c.quality === "good");
---

<section class="leaf-section wrap" id="today">
  <div class="section-head reveal">
    <h2>The calendar works offline. <em>It'll outlive your internet, your battery, and possibly you.</em></h2>
    <p class="lede">
      Dates, tithi, festivals and public holidays for {ne(supportedRange.firstEventYear)} to
      {ne(supportedRange.lastEventYear)} are built into the app. 
    </p>
  </div>

  <div class:list={["leaf", "reveal", { "is-holiday": todayIsHoliday }]}>
    <div class="leaf-date">
      <p class="leaf-month" lang="ne">{today.nepaliMonthName} {ne(today.nepali.year)}</p>
      <p class="leaf-day" lang="ne">{ne(today.nepali.day)}</p>
      <p class="leaf-weekday" lang="ne">{weekdayNe(today.weekday)}</p>
      <p class="leaf-ad num">{longDate(today.gregorian)}</p>
    </div>

    <dl class="leaf-facts">
      <div>
        <dt>Tithi</dt>
        <dd lang="ne">{todayTithi ?? "—"}</dd>
      </div>
      <div>
        <dt>Sunrise</dt>
        <dd class="num">{nepalClock(kathmandu.sunrise)}</dd>
      </div>
      <div>
        <dt>Sunset</dt>
        <dd class="num">{nepalClock(kathmandu.sunset)}</dd>
      </div>
      <div>
        <dt>Kathmandu</dt>
        <dd class="num">{kathmandu.temperature}°, {kathmandu.condition}</dd>
      </div>
    </dl>

    <div class="leaf-next">
      <p class="leaf-next-title">Coming up</p>
      <ol>
        {upcoming.map((e, i) => (
          <li class:list={["reveal", { "is-holiday": e.is_public_holiday }]} style={`--d:${i * 70}ms`}>
            <span class="next-date" lang="ne">{ne(e.date.day)}</span>
            <span class="next-body">
              <span class="next-name" lang="ne">{e.name.replace(/\(.*?\)/g, "").trim()}</span>
              <span class="next-when">
                {daysAway(e.days_away)}
                {e.is_public_holiday && <em>Public holiday</em>}
              </span>
            </span>
          </li>
        ))}
      </ol>
    </div>

    {panchang && (
      <div class="leaf-panchang">
        <p class="leaf-panchang-title">Panchang, not just tithi</p>
        <p>
          Nakshatra <strong lang="ne">{panchang.almanac.nakshatra.ne}</strong>, yoga
          <strong lang="ne"> {panchang.almanac.yoga.ne}</strong>. It also knows the one window a wall
          calendar has warned about for centuries:
          {panchang.rahuKaalStart && panchang.rahuKaalEnd && (
            <> Rahu Kaal runs <strong class="num">{nepalClock(panchang.rahuKaalStart)}–{nepalClock(panchang.rahuKaalEnd)}</strong> today — reschedule that call.</>
          )}
          {goodWindow && (
            <> If you're starting something instead, <strong lang="ne">{goodWindow.name.ne}</strong> opens at <strong class="num">{nepalClock(goodWindow.start)}</strong>.</>
          )}
        </p>
      </div>
    )}

    <p class="leaf-foot">
      You can add a note to any day, get a reminder the evening before a festival, and convert dates between
      BS and AD.
    </p>
  </div>
</section>

<style>
  .leaf-section {
    position: relative;
    z-index: 1;
    padding-top: clamp(72px, 10vw, 140px);
  }
  .leaf {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas:
      "date next"
      "facts next"
      "panchang panchang"
      "foot foot";
    gap: 0 clamp(28px, 5vw, 72px);
    padding: clamp(28px, 4vw, 52px);
    background: var(--paper);
    color: var(--ink);
    border-radius: 6px;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6);
    /* The little punched hole of a wall calendar. */
    position: relative;
  }
  .leaf::before {
    content: "";
    position: absolute;
    top: 14px;
    left: 50%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    transform: translateX(-50%);
    background: var(--ink);
    box-shadow: inset 0 2px 3px rgb(0 0 0 / 0.5);
  }
  .leaf-date {
    grid-area: date;
    display: grid;
    align-content: start;
    padding-top: 10px;
  }
  .leaf-month {
    font-family: var(--deva);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--paper-4);
  }
  /* Red only on a holiday. That is the one rule every wall patro follows. */
  .leaf-day {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(160px, 22vw, 260px);
    line-height: 0.82;
    color: var(--ink);
    margin: 8px 0 14px -0.03em;
  }
  .leaf.is-holiday .leaf-day {
    color: var(--sindoor);
  }
  .leaf-weekday {
    font-family: var(--deva);
    font-size: 26px;
    font-weight: 600;
  }
  .leaf-ad {
    color: var(--paper-4);
    font-size: 15px;
  }
  .leaf-facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 24px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid rgb(20 17 14 / 0.15);
  }
  .leaf-facts dt {
    font-size: 13px;
    color: var(--paper-4);
  }
  .leaf-facts dd {
    font-size: 18px;
    font-weight: 600;
    margin-top: 2px;
  }
  .leaf-next {
    grid-area: next;
    padding-top: 10px;
    border-left: 1px solid rgb(20 17 14 / 0.15);
    padding-left: clamp(20px, 3vw, 40px);
  }
  .leaf-next-title {
    font-size: 13px;
    color: var(--paper-4);
    margin-bottom: 14px;
  }
  .leaf-next li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid rgb(20 17 14 / 0.12);
  }
  .next-date {
    font-family: var(--display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    color: var(--ink);
  }
  .is-holiday .next-date {
    color: var(--sindoor);
  }
  .next-name {
    display: block;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }
  .next-when {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    color: var(--paper-4);
  }
  .next-when em {
    font-style: normal;
    margin-left: 8px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--sindoor);
    color: var(--paper);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .leaf-panchang {
    grid-area: panchang;
    margin-top: 24px;
    padding: 16px 20px;
    background: rgb(20 17 14 / 0.05);
    border-radius: 4px;
    border-left: 3px solid var(--sindoor);
  }
  .leaf-panchang-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper-4);
    margin-bottom: 6px;
  }
  .leaf-panchang p {
    font-size: 15px;
    line-height: 1.55;
    max-width: 68ch;
  }
  .leaf-panchang strong {
    font-weight: 700;
  }
  .leaf-foot {
    grid-area: foot;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid rgb(20 17 14 / 0.15);
    color: var(--paper-4);
    max-width: 70ch;
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .leaf {
      grid-template-columns: 1fr;
      grid-template-areas: "date" "facts" "next" "panchang" "foot";
    }
    .leaf-next {
      border-left: 0;
      padding-left: 0;
      margin-top: 28px;
      border-top: 1px solid rgb(20 17 14 / 0.15);
      padding-top: 22px;
    }
  }
</style>
