---
/**
 * Every download, for every system, side by side. The visitor's own system
 * gets a "For you" mark and, on a phone-width screen, the first place, but
 * nothing is hidden and nothing redirects: a wrong guess costs a glance, not
 * a detour. Used by the home page's Install section and the Download page.
 */
const platforms = [
  {
    id: "macos",
    name: "macOS",
    step: "Drag to Applications, open it, then click Open Anyway under Privacy & Security.",
    find: "At the top of your screen, in the menu bar. There's no Dock icon.",
    link: { href: "/docs/install-macos.html", label: "Step-by-step with screenshots" },
    dl: [
      { id: "macos-arm64", label: "Apple chip (M1 or newer)" },
      { id: "macos-x64", label: "Intel Mac" },
    ],
  },
  {
    id: "windows",
    name: "Windows",
    step: "If the browser says the file isn't commonly downloaded, choose Keep. SmartScreen then shows a warning: click More info, then Run anyway.",
    find: "Bottom right, next to the clock. Not there? Click the ^ arrow and drag the Nepal flag out beside the clock.",
    link: { href: "/docs/install-windows.html", label: "Install and find the tray icon" },
    dl: [{ id: "windows", label: "Installer (.exe)" }],
  },
  {
    id: "linux",
    name: "Linux",
    step: "The .deb for Ubuntu and Mint, the .rpm for Fedora and openSUSE, or the AppImage anywhere else, Arch included.",
    find: "In your top bar. No top bar, or nothing there? Open Sajilo from your apps menu.",
    link: { href: "/docs/install-linux.html", label: "Commands and tray setup" },
    dl: [
      { id: "linux-deb", label: ".deb" },
      { id: "linux-rpm", label: ".rpm" },
      { id: "linux-appimage", label: "AppImage" },
    ],
  },
];

interface Props {
  /** Heading level for each system's name: h3 under a section, h2 on a page. */
  level?: "h2" | "h3";
}
const { level = "h3" } = Astro.props;
const Heading = level;
---

<ul class="platform-grid">
  {platforms.map((p, i) => (
    <li class="platform reveal" id={p.id} data-os={p.id} style={`--d:${i * 90}ms`}>
      <div class="platform-head">
        <Heading>{p.name}</Heading>
        <span class="platform-yours" hidden>For you</span>
      </div>
      <p class="platform-step">{p.step}</p>
      <p class="platform-find"><span>Where it lives</span>{p.find}</p>
      <div class="platform-dl">
        {p.dl.map((d) => (
          <a class="btn btn--ghost btn--sm" href={`/dl/${d.id}`} data-platform={d.id}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1.5a.75.75 0 0 1 .75.75v6.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V2.25A.75.75 0 0 1 8 1.5ZM2.75 11a.75.75 0 0 1 .75.75v1.5h9v-1.5a.75.75 0 0 1 1.5 0v2.25a.75.75 0 0 1-.75.75h-10.5a.75.75 0 0 1-.75-.75v-2.25a.75.75 0 0 1 .75-.75Z"/></svg>
            {d.label}
          </a>
        ))}
      </div>
      {p.link && <a class="platform-link" href={p.link.href}>{p.link.label} →</a>}
    </li>
  ))}
</ul>

<script>
  import { detectPlatform } from "../scripts/platform";

  // A guess marks, it never hides: the visitor's card gets "For you" and its
  // likeliest file is filled in, and every other button stays as it was.
  const detected = detectPlatform();
  const os = detected.platform.startsWith("macos")
    ? "macos"
    : detected.platform.startsWith("linux")
      ? "linux"
      : "windows";
  document.querySelectorAll<HTMLElement>(`.platform[data-os="${os}"]`).forEach((card) => {
    card.classList.add("is-yours");
    card.querySelector<HTMLElement>(".platform-yours")?.removeAttribute("hidden");
    // Linux has no single likeliest file; the three are equal choices.
    if (os === "linux") return;
    card
      .querySelector<HTMLElement>(`[data-platform="${detected.platform}"]`)
      ?.classList.replace("btn--ghost", "btn--accent");
  });
</script>

<style>
  .platform-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .platform {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 28px 26px 30px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--ink-2);
    transition: border-color 0.3s, transform 0.4s var(--ease);
  }
  .platform:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }
  .platform-step {
    color: var(--paper-2);
    font-size: 15px;
    min-height: 3lh;
  }
  .platform-find {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--ink);
    border: 1px solid var(--line);
    color: var(--paper);
    font-size: 14px;
    line-height: 1.45;
  }
  .platform-find span {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gilt);
  }
  .platform-dl {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .platform-link {
    font-size: 14px;
    color: var(--gilt);
    width: fit-content;
  }
  .platform-link:hover {
    color: var(--gilt-2);
  }
  @media (max-width: 760px) {
    .platform-grid { grid-template-columns: 1fr; }
    .platform-step { min-height: 0; }
  }
  .platform-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .platform-head :is(h2, h3) {
    font-family: var(--display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
  }
  .platform-yours {
    padding: 4px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--gilt) 16%, transparent);
    color: var(--gilt);
    font-size: 12px;
    font-weight: 600;
  }
  .platform.is-yours,
  .platform:target {
    border-color: color-mix(in srgb, var(--gilt) 55%, transparent);
  }
  @media (max-width: 760px) {
    .platform.is-yours { order: -1; }
  }
</style>
