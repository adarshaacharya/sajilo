---
// Notes, as a new install opens it: the app's own welcome note, read by the
// same parser the app reads every note with (apps/showcase-data,
// record_notes). No note anyone wrote is shown.
import AppFrame from "./AppFrame.astro";

const points = [
  { en: "Jot a line. It lands in today's note." },
  { en: "Office and Personal, never mixed." },
  { en: "Tap ने: mero naam becomes मेरो नाम." },
  { en: "Stays on your computer." },
];
---

<section class="notes wrap" id="notes" aria-labelledby="notes-title">
  <div class="notes-grid">
    <div class="notes-main">
      <div class="section-head reveal">
        <p class="notes-mark">
          <span lang="ne">नोट</span>
          <span class="notes-mark-en">Notes</span>
        </p>
        <h2 id="notes-title">Remember what the boss said in the meeting. <em>Unlike the boss.</em></h2>
      </div>

      <ul class="notes-points reveal">
        {points.map((point) => <li>{point.en}</li>)}
      </ul>
    </div>

    <div class="notes-stage reveal">
      <AppFrame route="/notes?open=welcome" title="Sajilo Notes, showing the welcome note" />
    </div>
  </div>
</section>

<style>
  .notes {
    position: relative;
    z-index: 1;
    padding-top: clamp(80px, 11vw, 160px);
  }
  .notes-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .notes-mark {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px;
  }
  .notes-mark [lang="ne"] {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    color: var(--gilt-2);
  }
  .notes-mark-en {
    font-size: 15px;
    font-weight: 500;
    color: var(--paper-3);
  }
  .notes-points {
    display: grid;
    gap: 12px;
    margin-top: clamp(24px, 3vw, 36px);
    padding: 0;
    list-style: none;
  }
  .notes-points li {
    position: relative;
    padding-left: 22px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--paper-2);
  }
  .notes-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    border: 1.5px solid var(--gilt-2);
  }
  @media (max-width: 860px) {
    .notes-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .notes-stage {
      max-width: 340px;
    }
  }
</style>
