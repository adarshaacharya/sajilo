---
import { recordedAt } from "../data/showcase";
const recorded = new Date(recordedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Kathmandu" });
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <p class="footer-mark" lang="ne">सजिलो</p>
      <p class="footer-line">Bikram Sambat calendar and Nepali daily information in the menu bar.</p>
      <p class="footer-contact">
        <a href="mailto:contact@sajilo.fyi">contact@sajilo.fyi</a>
      </p>
    </div>
    <nav class="footer-col" aria-label="Product">
      <p class="eyebrow">Product</p>
      <a href="/#download" data-download>Download</a>
      <a href="/docs.html">Docs</a>
      <a href="/docs/troubleshooting.html">Troubleshooting</a>
      <a href="/#tour">Every screen</a>
      <a href="/#stocks">Stocks</a>
    </nav>
    <nav class="footer-col" aria-label="Project">
      <p class="eyebrow">Project</p>
      <a href="https://github.com/adarshaacharya/sajilo" target="_blank" rel="noopener">GitHub</a>
      <a href="/releases.html">Releases</a>
      <a href="/report.html">Report an issue</a>
      <a href="/support.html">Support Sajilo</a>
      <a href="/privacy.html">Privacy</a>
      <a href="/license.html">MIT licence</a>
    </nav>
  </div>
  <div class="wrap footer-bottom">
    <p>Values on this page were recorded on {recorded}.</p>
    <p>By <a href="https://adarsha.dev" target="_blank" rel="noopener">Adarsha Acharya</a></p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: clamp(80px, 10vw, 140px);
    border-top: 1px solid var(--line);
    background: var(--ink-2);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
    padding-block: 56px 40px;
  }
  .footer-mark {
    font-family: var(--display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    margin-bottom: 14px;
  }
  .footer-line {
    color: var(--paper-2);
    max-width: 34ch;
  }
  .footer-contact {
    margin-top: 10px;
    color: var(--paper-3);
    font-size: 14px;
  }
  .footer-contact a {
    color: var(--gilt);
  }
  .footer-col {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .footer-col .eyebrow {
    margin-bottom: 6px;
  }
  .footer-col a {
    color: var(--paper-2);
    font-size: 15px;
    width: fit-content;
    transition: color 0.2s;
  }
  .footer-col a:hover {
    color: var(--paper);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-block: 20px 28px;
    border-top: 1px solid var(--line);
    color: var(--paper-3);
    font-size: 13px;
  }
  .footer-bottom a {
    font-weight: 500;
    color: var(--gilt-2);
    text-decoration: underline;
    text-decoration-color: rgb(240 198 106 / 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }
  .footer-bottom a:hover {
    text-decoration-color: currentColor;
  }
  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
