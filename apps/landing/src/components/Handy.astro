---
// The two small tools people end up leaning on: a second clock, drawn as the
// wall of clocks behind a hotel desk — but hung for where Nepali families
// actually are — and the Directory, as the numbers page at the back of a
// school diary. The clocks keep the visitor's real time; the numbers and
// sites are the app's own list (features/tools/_lib/directory.ts).
import { CONTACTS, WEBSITES } from "../../../desktop/src/features/tools/_lib/directory";

const clocks = [
  { tz: "Asia/Kathmandu", en: "Kathmandu", ne: "काठमाडौं" },
  { tz: "Asia/Qatar", en: "Doha", ne: "दोहा" },
  { tz: "Asia/Dubai", en: "Dubai", ne: "दुबई" },
  { tz: "Asia/Kuala_Lumpur", en: "Kuala Lumpur", ne: "क्वालालम्पुर" },
  { tz: "Asia/Seoul", en: "Seoul", ne: "सोल" },
  { tz: "Australia/Sydney", en: "Sydney", ne: "सिड्नी" },
  { tz: "Europe/London", en: "London", ne: "लन्डन" },
  { tz: "America/New_York", en: "New York", ne: "न्युयोर्क" },
];

// The short numbers first: the ones a diary would print, and anyone can dial.
const numbers = CONTACTS.filter((contact) => /^\d{3,4}$/.test(contact.number)).slice(0, 12);
// The errands people actually queue for, picked from the same list. Anything
// renamed in the app simply drops off the page rather than breaking it.
const PICKS = [
  "Passport application",
  "Passport status",
  "National ID portal",
  "Driving licence application",
  "Licence print checker",
  "Police clearance",
  "Taxpayer portal",
  "Health Insurance e-Portal",
  "Mero Kitta",
  "Foreign employment search",
  "Nagarik App",
  "Election Commission",
];
const sites = PICKS.map((name) => WEBSITES.find((site) => site.name === name)).filter(
  (site) => site !== undefined,
);
const TYPE_LABEL = { portal: "Apply", checker: "Check", app: "App" } as const;
const host = (url: string) =>
  url.includes("play.google.com") ? "Google Play" : new URL(url).hostname.replace(/^www\./, "");
---

<section class="handy wrap" id="handy" aria-labelledby="handy-title">
  <div class="section-head reveal">
    <p class="handy-mark">
      <span lang="ne">घडी र डायरी</span>
      <span class="handy-mark-en">Second clock · Directory</span>
    </p>
    <h2 id="handy-title">Don't wake Dai in Sydney. <em>Do call 102.</em></h2>
    <p class="lede">
      Son in Sydney, sister in Doha, best friend in New York. Add their cities and Sajilo keeps their
      time next to yours, so you know who is awake before you call. And for home: the emergency numbers
      and sarkari sites, kept where you will find them.
    </p>
  </div>

  <div class="handy-grid">
    <div class="clock-wall reveal">
      <p class="wall-plate">
        Nepal is <b data-np-offset>UTC +5:45</b>. Never a round number.
      </p>
      <ul class="clocks">
        {clocks.map((clock, i) => (
          <li class:list={["clock", { home: i === 0 }]} data-tz={clock.tz}>
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <circle class="face" cx="50" cy="50" r="46" />
              {Array.from({ length: 12 }, (_, tick) => (
                <line
                  class:list={["tick", { major: tick % 3 === 0 }]}
                  x1="50"
                  y1="8"
                  x2="50"
                  y2={tick % 3 === 0 ? 16 : 13}
                  transform={`rotate(${tick * 30} 50 50)`}
                />
              ))}
              <line class="hand hour" x1="50" y1="54" x2="50" y2="28" />
              <line class="hand minute" x1="50" y1="56" x2="50" y2="16" />
              <line class="hand second" x1="50" y1="60" x2="50" y2="12" />
              <circle class="pin" cx="50" cy="50" r="2.4" />
            </svg>
            <p class="clock-city">
              <span lang="ne">{clock.ne}</span>
              <span class="clock-en">{clock.en}</span>
            </p>
            <p class="clock-read">
              <span class="clock-time" data-time>--:--</span>
              <span class="clock-diff" data-diff></span>
            </p>
            <p class="clock-mood" data-mood aria-live="off"></p>
          </li>
        ))}
      </ul>
    </div>

    <div class="diary reveal">
      <p class="diary-title" lang="ne">महत्त्वपूर्ण टेलिफोन नम्बरहरू</p>
      <p class="diary-sub">Important telephone numbers</p>
      <ol class="diary-list">
        {numbers.map((contact) => (
          <li class:list={["entry", contact.tone]}>
            <span class="entry-name">
              <span lang="ne">{contact.nameNe}</span>
              <span class="entry-en">{contact.name}</span>
            </span>
            <span class="entry-dots" aria-hidden="true"></span>
            <span class="entry-number">{contact.number}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="sites-page reveal">
      <div class="sites-head">
        <p class="diary-title" lang="ne">उपयोगी वेबसाइट</p>
        <p class="sites-stamp">{WEBSITES.length} official sites &amp; apps in the app</p>
      </div>
      <ul class="sites">
        {sites.map((site) => (
          <li class="site">
            <p class="site-top">
              <span class:list={["site-type", site.type]}>{TYPE_LABEL[site.type]}</span>
              <span class="site-host">{host(site.url)}</span>
            </p>
            <p class="site-name">
              <span lang="ne">{site.nameNe}</span>
              <span class="entry-en">{site.name}</span>
            </p>
            <p class="site-desc">{site.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .handy {
    position: relative;
    z-index: 1;
    padding-top: clamp(80px, 11vw, 160px);
  }
  .handy-mark {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .handy-mark [lang="ne"] {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    color: var(--gilt-2);
  }
  .handy-mark-en {
    font-size: 15px;
    font-weight: 500;
    color: var(--paper-3);
  }

  .handy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
    margin-top: clamp(28px, 4vw, 48px);
  }

  /* The wall behind a hotel reception desk: a brass plate and a row of
     identical clocks, each one showing someone's evening or someone's 3am. */
  .clock-wall {
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.015) 0 2px, transparent 2px 9px),
      linear-gradient(180deg, var(--ink-3), var(--ink-2));
  }
  .wall-plate {
    width: fit-content;
    margin: 0 auto clamp(20px, 3vw, 30px);
    padding: 7px 16px;
    border-radius: 3px;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: #2a1f0c;
    background: linear-gradient(180deg, #e9c877, #b98d38);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.35) inset,
      0 6px 14px -8px rgb(0 0 0 / 0.8);
  }
  .clocks {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2.6vw, 30px) clamp(10px, 2vw, 22px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .clock {
    text-align: center;
  }
  .clock svg {
    display: block;
    width: min(100%, 118px);
    margin: 0 auto;
    filter: drop-shadow(0 10px 12px rgb(0 0 0 / 0.5));
  }
  .face {
    fill: var(--paper);
    stroke: #3a332c;
    stroke-width: 3;
    transition: fill 0.6s ease;
  }
  .tick {
    stroke: rgb(34 28 20 / 0.45);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .tick.major {
    stroke: #221c14;
    stroke-width: 2.4;
  }
  .hand {
    stroke: #221c14;
    stroke-linecap: round;
    transform-origin: 50px 50px;
  }
  .hand.hour {
    stroke-width: 4;
  }
  .hand.minute {
    stroke-width: 2.6;
  }
  .hand.second {
    stroke: #d63c2c;
    stroke-width: 1.1;
  }
  .pin {
    fill: #d63c2c;
  }
  .home .face {
    stroke: var(--gilt);
  }

  /* Night clocks go dark, so the room reads at a glance: who is asleep. */
  .clock.night .face {
    fill: #25211d;
  }
  .clock.night .tick,
  .clock.night .tick.major {
    stroke: rgb(243 233 214 / 0.35);
  }
  .clock.night .hand:not(.second) {
    stroke: var(--paper-2);
  }

  .clock-city {
    margin-top: 10px;
    line-height: 1.2;
  }
  .clock-city [lang="ne"] {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: 16px;
    color: var(--paper);
  }
  .clock-en {
    font-size: 11.5px;
    color: var(--paper-3);
  }
  .clock-read {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 6px;
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .clock-time {
    font-size: 14px;
    font-weight: 600;
    color: var(--paper-2);
  }
  .clock-diff {
    font-size: 11px;
    color: var(--paper-4);
  }
  .clock-mood {
    min-height: 1.3em;
    margin-top: 2px;
    font-size: 11.5px;
    color: var(--gilt-2);
  }
  .clock.night .clock-mood {
    color: var(--paper-4);
  }

  /* The last page of a school diary: printed heading, dotted leaders, and a
     rubber stamp someone added later. */
  .diary {
    position: relative;
    padding: clamp(22px, 3vw, 32px) clamp(20px, 3vw, 34px);
    color: #221c14;
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(0 0 0 / 0.06), transparent 60%),
      #efe4cc;
    border-radius: 3px 10px 10px 3px;
    border-left: 10px solid #7a2a22;
    transform: rotate(0.7deg);
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.85);
  }
  .diary-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 25px);
    line-height: 1.2;
    text-align: center;
  }
  .diary-sub {
    margin-top: 2px;
    padding-bottom: 12px;
    border-bottom: 2px double rgb(34 28 20 / 0.35);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: rgb(34 28 20 / 0.55);
  }
  .diary-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .entry {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 0;
  }
  .entry-name {
    min-width: 0;
    line-height: 1.2;
  }
  .entry-name [lang="ne"] {
    font-size: 15px;
    font-weight: 600;
  }
  .entry-en {
    margin-left: 6px;
    font-size: 11.5px;
    color: rgb(34 28 20 / 0.5);
  }
  .entry-dots {
    flex: 1;
    min-width: 16px;
    border-bottom: 2px dotted rgb(34 28 20 / 0.28);
    transform: translateY(-4px);
  }
  .entry-number {
    font-family: var(--display);
    font-weight: 700;
    font-size: 19px;
    font-variant-numeric: tabular-nums;
    color: #1d3f6e;
  }
  .entry.urgent .entry-number {
    color: #b8321f;
  }

  /* The facing page of the same diary, ruled into columns by hand. */
  .sites-page {
    grid-column: 1 / -1;
    padding: clamp(22px, 3vw, 32px) clamp(20px, 3vw, 34px);
    color: #221c14;
    background:
      repeating-linear-gradient(180deg, transparent 0 31px, rgb(76 118 168 / 0.14) 31px 32px),
      #efe4cc;
    border-radius: 3px 10px 10px 3px;
    border-left: 10px solid #7a2a22;
    transform: rotate(-0.4deg);
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.85);
  }
  .sites-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding-bottom: 12px;
    border-bottom: 2px double rgb(34 28 20 / 0.35);
  }
  .sites-head .diary-title {
    text-align: left;
  }
  .sites-stamp {
    padding: 3px 10px;
    border: 2px solid rgb(29 63 110 / 0.75);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(29 63 110 / 0.85);
    transform: rotate(-2.5deg);
  }
  .sites {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0 clamp(16px, 2.4vw, 28px);
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }
  .site {
    padding: 12px 0;
    border-bottom: 1px dashed rgb(34 28 20 / 0.18);
  }
  .site-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
  }
  .site-type {
    padding: 1px 7px;
    border-radius: 3px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #efe4cc;
    background: #1d3f6e;
  }
  .site-type.checker {
    background: #2f6b3a;
  }
  .site-type.app {
    background: #7a2a22;
  }
  .site-host {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: rgb(34 28 20 / 0.5);
  }
  .site-name {
    margin-top: 6px;
    line-height: 1.25;
  }
  .site-name [lang="ne"] {
    display: block;
    font-size: 15.5px;
    font-weight: 600;
  }
  .site-name .entry-en {
    margin-left: 0;
  }
  .site-desc {
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.4;
    color: rgb(34 28 20 / 0.68);
  }

  @media (max-width: 960px) {
    .handy-grid {
      grid-template-columns: 1fr;
    }
    .diary,
    .sites-page {
      transform: none;
    }
  }
  @media (max-width: 520px) {
    .clocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .entry-en {
      display: none;
    }
  }
</style>

<script>
  const HOME = "Asia/Kathmandu";

  /** Wall-clock reading in a zone, and that zone's UTC offset in minutes. */
  function read(timeZone: string, now: Date) {
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat("en-US", {
        timeZone,
        hourCycle: "h23",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      })
        .formatToParts(now)
        .map((part) => [part.type, part.value]),
    );
    const h = Number(parts.hour);
    const m = Number(parts.minute);
    const s = Number(parts.second);
    const wall = Date.UTC(+parts.year, +parts.month - 1, +parts.day, h, m, s);
    const offset = Math.round((wall - now.getTime()) / 60_000);
    return { h, m, s, offset };
  }

  const span = (minutes: number) => {
    const sign = minutes < 0 ? "−" : "+";
    const abs = Math.abs(minutes);
    return `${sign}${Math.floor(abs / 60)}:${String(abs % 60).padStart(2, "0")}`;
  };

  function mood(h: number) {
    if (h >= 23 || h < 6) return "Asleep. Text instead.";
    if (h < 9) return "Getting ready";
    if (h >= 21) return "Winding down";
    if (h >= 9 && h < 18) return "At work";
    return "Good time to call";
  }

  const clocks = [...document.querySelectorAll<HTMLElement>(".clock[data-tz]")];
  const plate = document.querySelector<HTMLElement>("[data-np-offset]");

  function tick() {
    const now = new Date();
    const home = read(HOME, now);
    if (plate) plate.textContent = `UTC ${span(home.offset)}`;
    for (const clock of clocks) {
      const tz = clock.dataset.tz ?? HOME;
      const r = read(tz, now);
      const set = (selector: string, deg: number) =>
        clock.querySelector<SVGElement>(selector)?.style.setProperty("transform", `rotate(${deg}deg)`);
      set(".hour", (r.h % 12) * 30 + r.m * 0.5);
      set(".minute", r.m * 6 + r.s * 0.1);
      set(".second", r.s * 6);
      clock.classList.toggle("night", r.h >= 21 || r.h < 6);
      const time = clock.querySelector("[data-time]");
      if (time) time.textContent = `${String(r.h).padStart(2, "0")}:${String(r.m).padStart(2, "0")}`;
      const diff = clock.querySelector("[data-diff]");
      if (diff) diff.textContent = tz === HOME ? "home" : span(r.offset - home.offset);
      const feel = clock.querySelector("[data-mood]");
      if (feel) feel.textContent = mood(r.h);
    }
  }

  tick();
  setInterval(tick, 1000);
</script>
