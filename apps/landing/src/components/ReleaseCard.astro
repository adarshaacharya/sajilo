---
import type { RenderedRelease } from "../lib/releases";
import { formatSize } from "../lib/releases";

interface Props {
  release: RenderedRelease;
  /** List view links to the detail page and shows an excerpt; the detail page shows everything in full, including the build table. */
  full?: boolean;
  isLatest?: boolean;
}
const { release: r, full = false, isLatest = false } = Astro.props;
---

<li class="release" id={r.version}>
  <div class="release-head">
    {full ? (
      <h1 class="release-version num">{r.version}</h1>
    ) : (
      <a class="release-version num" href={`/releases/${r.version}.html`}>{r.version}</a>
    )}
    <p class="release-date">{r.date}</p>
    {r.prerelease && <span class="release-tag">Pre-release</span>}
    {isLatest && <span class="release-latest">Latest</span>}
  </div>

  {full ? (
    <div class="release-body" set:html={r.bodyHtml} />
  ) : (
    <p class="release-excerpt">{r.excerpt}</p>
  )}

  {full && r.assets.length > 0 && (
    <div class="release-assets-scroll">
    <table class="release-assets">
      <caption>Builds for {r.version}</caption>
      <thead>
        <tr>
          <th scope="col">Platform</th>
          <th scope="col">File</th>
          <th scope="col">Size</th>
          <th scope="col"><span class="sr-only">Download</span></th>
        </tr>
      </thead>
      <tbody>
        {r.assets.map((a) => (
          <tr>
            <td>{a.label}</td>
            <td class="release-assets-file"><code>{a.filename}</code></td>
            <td class="num">{formatSize(a.size)}</td>
            <td>
              <a class="release-assets-dl" href={a.url}>
                Download
                <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1.5a.75.75 0 0 1 .75.75v6.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V2.25A.75.75 0 0 1 8 1.5ZM2.75 11a.75.75 0 0 1 .75.75v1.5h9v-1.5a.75.75 0 0 1 1.5 0v2.25a.75.75 0 0 1-.75.75h-10.5a.75.75 0 0 1-.75-.75v-2.25a.75.75 0 0 1 .75-.75Z"/></svg>
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  )}

  <div class="release-links">
    {!full && <a class="release-more" href={`/releases/${r.version}.html`}>Full release notes →</a>}
    <a class="release-gh" href={r.htmlUrl} target="_blank" rel="noopener">View {r.version} on GitHub</a>
  </div>
</li>

<style>
  .release {
    padding: 24px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 84px;
  }
  .release:first-child {
    border-top: none;
    padding-top: 0;
  }
  .release:target {
    background: color-mix(in srgb, var(--gilt) 6%, transparent);
    margin-inline: -20px;
    padding-inline: 20px;
    border-radius: 12px;
  }

  .release-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .release-version {
    display: inline-block;
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    color: var(--gilt-2);
    transition: color 0.15s;
  }
  a.release-version:hover {
    color: var(--gilt);
    text-decoration: underline;
    text-decoration-color: rgb(240 198 106 / 0.4);
    text-underline-offset: 3px;
  }
  .release-date {
    font-size: 14px;
    color: var(--paper-3);
  }
  .release-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sindoor-2);
    padding: 3px 8px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }
  .release-latest {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--leaf);
    padding: 3px 8px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .release-assets-scroll {
    margin-top: 20px;
    overflow-x: auto;
  }
  .release-assets {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: 14px;
  }
  .release-assets caption {
    text-align: left;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-3);
    margin-bottom: 10px;
  }
  .release-assets th {
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: var(--paper-3);
    padding: 0 10px 8px;
    border-bottom: 1px solid var(--line-2);
  }
  .release-assets td {
    padding: 10px;
    border-bottom: 1px solid var(--line);
    color: var(--paper-2);
    vertical-align: middle;
  }
  .release-assets tr:last-child td {
    border-bottom: none;
  }
  .release-assets th:first-child,
  .release-assets td:first-child {
    padding-left: 0;
  }
  .release-assets th:last-child,
  .release-assets td:last-child {
    padding-right: 0;
  }
  .release-assets-file code {
    font-family: var(--mono);
    font-size: 0.85em;
    color: var(--paper-3);
  }
  .release-assets-dl {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--gilt-2);
    white-space: nowrap;
  }
  .release-assets-dl:hover {
    color: var(--gilt);
  }
  .release-assets-dl svg {
    width: 13px;
    height: 13px;
  }

  .release-excerpt {
    color: var(--paper-2);
    line-height: 1.6;
    font-size: 15px;
  }

  .release-body {
    color: var(--paper-2);
    line-height: 1.6;
    font-size: 15px;
  }
  .release-body :global(h2) {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    color: var(--paper);
    margin: 20px 0 8px;
  }
  .release-body :global(h2:first-child) {
    margin-top: 0;
  }
  .release-body :global(p) {
    margin: 10px 0;
  }
  .release-body :global(ul) {
    list-style: disc;
    padding-left: 22px;
    display: grid;
    gap: 6px;
    margin: 10px 0;
  }
  .release-body :global(li) {
    margin: 0;
  }
  .release-body :global(strong) {
    color: var(--paper);
    font-weight: 600;
  }
  .release-body :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--ink-3);
  }
  .release-body :global(blockquote) {
    margin: 14px 0;
    padding: 10px 16px;
    border-left: 3px solid var(--gilt);
    background: var(--ink-2);
    border-radius: 0 8px 8px 0;
    color: var(--paper-3);
    font-size: 14px;
  }
  .release-body :global(blockquote p) {
    margin: 0;
  }
  .release-body :global(a) {
    color: var(--gilt-2);
    text-decoration: underline;
    text-decoration-color: rgb(240 198 106 / 0.45);
    text-underline-offset: 2px;
  }

  .release-links {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .release-more {
    font-size: 13px;
    font-weight: 600;
    color: var(--gilt-2);
  }
  .release-more:hover {
    text-decoration: underline;
    text-decoration-color: rgb(240 198 106 / 0.45);
    text-underline-offset: 2px;
  }
  .release-gh {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--paper-3);
    transition: color 0.15s;
  }
  .release-gh:hover {
    color: var(--paper-2);
  }
</style>
