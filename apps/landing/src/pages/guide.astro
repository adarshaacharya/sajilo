---
import Base from "../layouts/Base.astro";

// The settings guide is now a page of the docs. This address stays for the
// links already out there, forwarding with their #section: the docs page uses
// the same section names (display, modules, system, about).
---

<Base
  title="Settings guide: Sajilo"
  description="Every Sajilo setting, explained."
  path="/guide.html"
  noindex
>
  <script is:inline slot="head">
    location.replace("/docs/settings.html" + location.hash);
  </script>
  <main class="wrap moved" id="main">
    <h1>The settings guide has moved to the docs</h1>
    <p><a href="/docs/settings.html">Go to Settings in the docs</a></p>
  </main>
</Base>

<style>
  .moved {
    position: relative;
    z-index: 1;
    padding-block: clamp(40px, 7vw, 90px);
  }
  .moved h1 {
    font-family: var(--display);
    font-size: clamp(28px, 4vw, 40px);
  }
  .moved p {
    margin-top: 18px;
  }
  .moved a {
    color: var(--gilt);
  }
</style>
