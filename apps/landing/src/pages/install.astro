---
import Base from "../layouts/Base.astro";

// Installing now lives in the docs, one page per system. This address stays
// because links to it are out on the web (install.html#windows and so on):
// it forwards to the matching page, by the #system in the link or, without
// one, by the visitor's own system.
const pages = [
  { id: "windows", name: "Windows", href: "/docs/install-windows.html" },
  { id: "macos", name: "macOS", href: "/docs/install-macos.html" },
  { id: "linux", name: "Linux", href: "/docs/install-linux.html" },
];
---

<Base
  title="Installing Sajilo"
  description="How to install Sajilo on Windows, macOS and Linux."
  path="/install.html"
  noindex
>
  <script is:inline slot="head">
    (function () {
      var pages = {
        windows: "/docs/install-windows.html",
        macos: "/docs/install-macos.html",
        linux: "/docs/install-linux.html",
      };
      var os = location.hash.slice(1);
      if (!pages[os]) {
        var ua = navigator.userAgent;
        os = /Windows/.test(ua) ? "windows" : /Mac/.test(ua) ? "macos" : /Linux/.test(ua) ? "linux" : "";
      }
      location.replace(pages[os] || "/docs.html");
    })();
  </script>
  <main class="wrap moved" id="main">
    <h1>Installing Sajilo has moved to the docs</h1>
    <ul>
      {pages.map((page) => <li><a href={page.href}>Install on {page.name}</a></li>)}
    </ul>
  </main>
</Base>

<style>
  .moved {
    position: relative;
    z-index: 1;
    padding-block: clamp(40px, 7vw, 90px);
  }
  .moved h1 {
    font-family: var(--display);
    font-size: clamp(28px, 4vw, 40px);
  }
  .moved ul {
    margin-top: 18px;
    display: grid;
    gap: 8px;
  }
  .moved a {
    color: var(--gilt);
  }
</style>
