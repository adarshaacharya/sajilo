---
import Base from "../layouts/Base.astro";

// Downloads and the first steps now live on /download.html, with a guide
// per system in the docs. This address stays because links to it are out on
// the web (install.html#windows and so on): it forwards, keeping the #system.
const pages = [
  { id: "windows", name: "Windows", href: "/docs/install-windows.html" },
  { id: "macos", name: "macOS", href: "/docs/install-macos.html" },
  { id: "linux", name: "Linux", href: "/docs/install-linux.html" },
];
---

<Base
  title="Installing Sajilo"
  description="How to install Sajilo on Windows, macOS and Linux."
  path="/install.html"
  noindex
>
  <script is:inline slot="head">
    // Every download now lives on one page, with nothing guessed away: the
    // #system in an old link (install.html#windows) carries over, so the
    // page opens on that card.
    location.replace("/download.html" + location.hash);
  </script>
  <main class="wrap moved" id="main">
    <h1>Installing Sajilo has moved</h1>
    <p><a href="/download.html">Download Sajilo</a></p>
    <ul>
      {pages.map((page) => <li><a href={page.href}>Install on {page.name}</a></li>)}
    </ul>
  </main>
</Base>

<style>
  .moved {
    position: relative;
    z-index: 1;
    padding-block: clamp(40px, 7vw, 90px);
  }
  .moved h1 {
    font-family: var(--display);
    font-size: clamp(28px, 4vw, 40px);
  }
  .moved ul {
    margin-top: 18px;
    display: grid;
    gap: 8px;
  }
  .moved a {
    color: var(--gilt);
  }
</style>
