---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import Film, { YOUTUBE_ID } from "../components/home/Film.astro";
import Calendar from "../components/home/Calendar.astro";
import Markets from "../components/home/Markets.astro";
import Everyday from "../components/home/Everyday.astro";
import Workday from "../components/home/Workday.astro";
import Tools from "../components/home/Tools.astro";
import Themes from "../components/home/Themes.astro";
import Close from "../components/home/Close.astro";

const description =
  "Bikram Sambat calendar, festivals, NEPSE, gold, fuel, Kalimati prices, weather, exchange rates, rashifal, radio, Nepali news and break reminders in a menu bar app. Free and open source. macOS, Windows, Linux.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sajilo",
  url: "https://sajilo.fyi/",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Windows, Linux",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  softwareHelp: "https://sajilo.fyi/docs.html",
  privacyPolicy: "https://sajilo.fyi/privacy.html",
  downloadUrl: "https://github.com/adarshaacharya/sajilo/releases/latest",
};

// The tour video in the Watch section, so search can show it as a video result.
const videoLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "Sajilo: everything Nepali, one click away",
  description:
    "A tour of Sajilo, the Nepali menu bar app: calendar and festivals, panchang, NEPSE and IPOs, SIP NAVs, gold, fuel and Kalimati prices, news, weather, a second clock, FM radio, rashifal, Routine and Keeper.",
  thumbnailUrl: "https://sajilo.fyi/assets/film/sajilo-tour.jpg",
  contentUrl: "https://sajilo.fyi/assets/film/sajilo-tour.mp4",
  embedUrl: `https://www.youtube.com/embed/${YOUTUBE_ID}`,
  uploadDate: "2026-09-26",
  duration: "PT1M24S",
};
---

<Base title="Sajilo: Nepal in your menu bar" description={description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(videoLd)} />
  <main>
    <Hero />
    <Film />
    <Calendar />
    <Markets />
    <Everyday />
    <Workday />
    <Tools />
    <Themes />
    <Close />
  </main>

  <script>
    // A soft light follows the pointer across whichever panel it is over.
    if (matchMedia("(hover: hover)").matches) {
      document.querySelectorAll<HTMLElement>(".panel").forEach((panel) => {
        panel.addEventListener("pointermove", (event) => {
          const box = panel.getBoundingClientRect();
          panel.style.setProperty("--mx", `${event.clientX - box.left}px`);
          panel.style.setProperty("--my", `${event.clientY - box.top}px`);
        });
      });
    }
  </script>
</Base>
