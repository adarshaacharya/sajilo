---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import Film, { YOUTUBE_ID } from "../components/Film.astro";
import PatroLeaf from "../components/PatroLeaf.astro";
import Tour from "../components/Tour.astro";
import Stocks from "../components/Stocks.astro";
import Bazar from "../components/Bazar.astro";
import Chhutti from "../components/Chhutti.astro";
import Weather from "../components/Weather.astro";
import Rashifal from "../components/Rashifal.astro";
import Radio from "../components/Radio.astro";
import Tools from "../components/Tools.astro";
import Handy from "../components/Handy.astro";
import Keeper from "../components/Keeper.astro";
import Focus from "../components/Focus.astro";
import News from "../components/News.astro";
import Principles from "../components/Principles.astro";
import Install from "../components/Install.astro";
import Help from "../components/Help.astro";
import Support from "../components/Support.astro";

const description =
  "Bikram Sambat calendar, festivals, NEPSE, gold, fuel, Kalimati prices, weather, exchange rates, rashifal, radio, Nepali news and break reminders in a menu bar app. Free and open source. macOS, Windows, Linux.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sajilo",
  url: "https://sajilo.fyi/",
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Windows, Linux",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  softwareHelp: "https://sajilo.fyi/docs.html",
  privacyPolicy: "https://sajilo.fyi/privacy.html",
  downloadUrl: "https://github.com/adarshaacharya/sajilo/releases/latest",
};

// The tour video in the Watch section, so search can show it as a video result.
const videoLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "Sajilo: everything Nepali, one click away",
  description:
    "A tour of Sajilo, the Nepali menu bar app: calendar and festivals, panchang, NEPSE and IPOs, SIP NAVs, gold, fuel and Kalimati prices, news, weather, a second clock, FM radio, rashifal, Routine and Keeper.",
  thumbnailUrl: "https://sajilo.fyi/assets/film/sajilo-tour.jpg",
  contentUrl: "https://sajilo.fyi/assets/film/sajilo-tour.mp4",
  embedUrl: `https://www.youtube.com/embed/${YOUTUBE_ID}`,
  uploadDate: "2026-09-26",
  duration: "PT1M24S",
};
---

<Base title="Sajilo: Nepal in your menu bar" description={description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(videoLd)} />
  <Hero />
  <Ticker />
  <Film />
  <PatroLeaf />
  <Chhutti />
  <Weather />
  <Tour />
  <Stocks />
  <Bazar />
  <Rashifal />
  <Radio />
  <Keeper />
  <Focus />
  <Tools />
  <Handy />
  <News />
  <Principles />
  <Install />
  <Help />
  <Support />
</Base>
