---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found: Sajilo" description="This page does not exist." path="/404.html" noindex>
  <main class="wrap lost" id="main">
    <p class="lost-num display" lang="ne">४०४</p>
    <h1 class="display">Not on this patro.</h1>
    <p class="lede">The link may be old, or mistyped. Downloads, the screens and the install guide are all back home.</p>
    <a class="btn" href="/">Back to Sajilo</a>
  </main>
</Base>

<style>
  .lost {
    position: relative;
    z-index: 1;
    min-height: 60vh;
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 16px;
    padding-block: 80px;
  }
  .lost-num {
    font-size: clamp(120px, 20vw, 220px);
    color: var(--sindoor);
    line-height: 0.9;
  }
  .lost h1 {
    font-size: clamp(32px, 5vw, 52px);
  }
  .lost .btn {
    margin-top: 12px;
  }
</style>
