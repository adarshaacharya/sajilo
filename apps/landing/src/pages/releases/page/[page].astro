---
import Base from "../../../layouts/Base.astro";
import ReleaseCard from "../../../components/ReleaseCard.astro";
import ReleasePager from "../../../components/ReleasePager.astro";
import { releasesForPage, pageCount } from "../../../lib/releases";

export function getStaticPaths() {
  // Page 1 lives at /releases.html; this route only needs to cover the rest.
  const total = pageCount();
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const page = Number(Astro.params.page);
const releases = releasesForPage(page);
---

<Base
  title={`Release notes, page ${page}: Sajilo`}
  description="What changed in every recent Sajilo release, straight from the source, without going through GitHub."
  path={`/releases/page/${page}.html`}
  noindex
>
  <main class="wrap releases" id="main">
    <h1 class="display releases-h1">Release notes</h1>
    <p class="lede">
      Every release, newest first. The app checks for these itself and offers to update.
    </p>

    <ol class="release-list">
      {releases.map((r) => <ReleaseCard release={r} />)}
    </ol>

    <ReleasePager page={page} pageCount={pageCount()} />
  </main>
</Base>

<style>
  .releases {
    position: relative;
    z-index: 1;
    padding-top: clamp(40px, 7vw, 90px);
    padding-bottom: 60px;
    max-width: 720px;
  }
  .releases-h1 {
    font-size: clamp(40px, 7vw, 68px);
    margin-bottom: 16px;
  }
  .releases .lede {
    max-width: none;
  }

  .release-list {
    display: grid;
    gap: 8px;
    margin-top: clamp(36px, 5vw, 52px);
  }
</style>
