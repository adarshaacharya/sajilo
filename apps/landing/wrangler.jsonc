{
  "name": "sajilo",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-23",
  // Every `wrangler deploy` builds the site first. Cloudflare Workers Builds
  // runs a bare `npx wrangler deploy` on a fresh clone, where `dist/` does not
  // exist yet — without this the deploy fails before uploading anything.
  "build": {
    "command": "bun run build"
  },
  "assets": {
    // Astro's build output, produced by the build command above.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Assets are served before the Worker runs, so `/dl/…` and `/api/…` —
    // which match no file — were answered with 404.html and never reached the
    // Worker. These routes have to reach the Worker first; every other path
    // keeps the assets-first behaviour.
    "run_worker_first": ["/dl/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sajilo-downloads",
      "database_id": "57dc714f-c9b0-4ea5-b14b-238bdc643e97"
    }
  ],
  "send_email": [
    {
      // Lets the Worker send exactly one place. Cloudflare requires this
      // destination to already be a verified address for the account —
      // `contact@sajilo.fyi` itself was never verified there, only
      // adarshaofficial@gmail.com was, so sends were failing silently.
      "name": "REPORT_EMAIL",
      "destination_address": "adarshaofficial@gmail.com",
    },
  ],
  "ratelimits": [
    {
      // Caps how often one visitor can hit /api/report, so filling it in by
      // hand a few times works fine but a script hammering it — or a flood of
      // spam — can't turn into an inbox full of email or a Cloudflare Email
      // Workers suspension. `namespace_id` just needs to be unique to this
      // binding within the Worker; it is not a resource that is created
      // anywhere.
      "name": "REPORT_LIMITER",
      "namespace_id": "1",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
