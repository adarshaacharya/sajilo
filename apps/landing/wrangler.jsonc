{
  "name": "sajilo",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-23",
  // Every `wrangler deploy` builds the site first. Cloudflare Workers Builds
  // runs a bare `npx wrangler deploy` on a fresh clone, where `dist/` does not
  // exist yet — without this the deploy fails before uploading anything.
  "build": {
    "command": "bun run build"
  },
  "assets": {
    // Astro's build output, produced by the build command above.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Assets are served before the Worker runs, so `/dl/…` — which matches no
    // file — was answered with 404.html and the redirect never happened. These
    // routes have to reach the Worker first; every other path keeps the
    // assets-first behaviour.
    "run_worker_first": ["/dl/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sajilo-downloads",
      "database_id": "57dc714f-c9b0-4ea5-b14b-238bdc643e97"
    }
  ]
}
