  "holiFest": [
    "०१सिथिः चःह्रे ०२शनि जयन्ती०३अधिकमास आरम्भ, मत्स्यनारायण  मेला आरम्भ, गोसाइँकुण्ड स्नान आरम्भ१०अष्टमीव्रत, गोरखकाली पूजा१२गोसाइँकुण्ड स्नान समाप्ति, वैतडी विश्वनाथ मन्दिरमा गङ्गादशहरा स्नानमेला१३पद्मिनी एकादशी१४प्रदोषव्रत१५गणतन्त्र दिवस१६पूर्णिमाव्रत१७अनला पुन्हिः२१जातीय भेदभाव तथा छुवाछुत उन्मूलन राष्ट्रिय दिवस२४रवि सप्तमी२५अष्टमीव्रत, गोरखकाली पूजा२८परमा एकादशी२९प्रदोषव्रत३०अनला चःह्रे:३१दर्शश्राद्ध•ललितपुर रातो मच्छिन्द्रनाथको भोटो देखाउने जात्राको दिन (काठमाडौं उपत्यकालाई मात्र बिदा)•ईद-उल-अज्हाको दिन (जेठ १४ गते वा सो पर्व पर्ने दिन) बिदा"
  ],
  "marriage": [
    "यो महिना को लागी विवाह मुर्हुत छैन ।"
