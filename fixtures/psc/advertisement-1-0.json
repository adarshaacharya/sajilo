4d\u091f\u0947\u0923\u094d\u091f \u0915\u093e\u0930\u094d\u0921\u093f\u092f\u094b\u0925\u094b\u0930\u093e\u0938\u093f\u0915 \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0915\u093e\u0930\u094d\u0921\u093f\u092f\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0915\u093f\u0921\u094d\u0928\u0940 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092a\u094d\u0932\u093e\u0928\u094d\u091f \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0915\u094d\u0932\u093f\u0928\u093f\u0915\u0932 \u091c\u0947\u0928\u0947\u091f\u093f\u0936\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0917\u094d\u092f\u093e\u0937\u094d\u091f\u094d\u0930\u094b\u0907\u0928\u094d\u091f\u0947\u0930\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u091a\u0947\u0937\u094d\u091f \u0921\u093f\u091c\u093f\u091c (\u092b\u093f\u091c\u093f\u0938\u093f\u092f\u0928),\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u091c\u0928\u0930\u0932 \u092b\u093f\u091c\u093f\u0938\u093f\u092f\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f ,\u091f\u094d\u0930\u092a\u093f\u0915\u0932 \u092e\u0947\u0921\u093f\u0938\u093f\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0921\u0930\u094d\u092e\u093e\u091f\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0921\u0947\u0928\u094d\u091f\u0932 \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0928\u093f\u0913\u0928\u0947\u091f\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0928\u0947\u092b\u094d\u0930\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0928\u094d\u092f\u0942\u0930\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u092a\u0947\u0921\u093f\u092f\u093e\u091f\u093f\u0938\u093f\u092f\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u092a\u0947\u0921\u093f\u092f\u093e\u091f\u094d\u0930\u093f\u0915 \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u092a\u094d\u092f\u093e\u0925\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u092d\u0947\u0937\u091c \u0935\u093f\u091c\u094d\u091e,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u0935\u093e\u092f\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u092e\u0947\u0921\u093f\u0915\u0932 \u0905\u0902\u0915\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u092f\u0942\u0930\u094b \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0930\u0947\u0921\u093f\u092f\u094b\u0925\u0947\u0930\u093e\u092a\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0930\u0947\u0921\u093f\u092f\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0938\u093e\u0907\u0915\u094d\u092f\u093e\u091f\u094d\u0930\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0938\u094d\u092a\u093e\u0907\u0928\u0932 \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0939\u0940\u0938\u094d\u091f\u094b \u092a\u094d\u092f\u093e\u0925\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0923\u094d\u091f \u0939\u0947\u092e\u093e\u091f\u094b\u0932\u094b\u091c\u093f\u0937\u094d\u091f,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0928\u094d\u091f \u0928\u094d\u092f\u0942\u0930\u094b \u0938\u0930\u094d\u091c\u0928,\u0915\u0928\u094d\u0938\u0932\u094d\u091f\u0947\u0928\u094d\u091f \u092e\u0947\u0921\u093f\u0915\u0932 \u091c\u0928\u0930\u0932\u093f\u0938\u094d\u091f,\u092b\u0930\u0947\u0928\u094d\u0938\u093f\u0915 \u092e\u0947\u0921\u093f\u0915\u0932 \u0905\u0927\u093f\u0915\u0943\u0924","totalOpenings":89,"advertisementCode":"17194-17260\/2083-84","singlePaymentLastDate":"2083-07-17","doublePaymentLastDate":"2083-07-24","paidApplications":14,"scrutinyApproved":0,"attendanceCount":0,"writtenSelectionCount":0,"finalSelectionCount":0},{"organizationName":"\u0932\u094b\u0915 \u0938\u0947\u0935\u093e \u0906\u092f\u094b\u0917, \u0915\u0947\u0928\u094d\u0926\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f","className":"\u0930\u093e\u0966\u092a\u0966 \u092a\u094d\u0930\u0925\u092e","post":"\u0938\u0939- \u0938\u091a\u093f\u0935 \u0935\u093e \u0938\u094b \u0938\u0930\u0939","totalOpenings":8,"advertisementCode":"16651-16655\/2083-84","singlePaymentLastDate":"2083-06-20","doublePaymentLastDate":"2083-06-27","paidApplications":289,"scrutinyApproved":257,"attendanceCount":0,"writtenSelectionCount":0,"finalSelectionCount":0},{"organizationName":"\u0932\u094b\u0915 \u0938\u0947\u0935\u093e \u0906\u092f\u094b\u0917, \u0915\u0947\u0928\u094d\u0926\u094d\u0930\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f","className":"\u0930\u093e\u0966\u092a\u0966 \u092a\u094d\u0930\u0925\u092e","post":"\u0938\u0939- \u0938\u091a\u093f\u0935 \u0935\u093e \u0938\u094b \u0938\u0930\u0939","